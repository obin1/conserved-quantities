#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: Set here the F90 compiler and options
#       Pedefined compilers: INTEL, PGF, HPUX, LAHEY
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Pick a default compiler if not supplied
ifndef COMPILER
#COMPILER = LAHEY
#COMPILER = INTEL
#COMPILER = PGF
#COMPILER = HPUX
COMPILER = GFORTRAN
endif

FC_LAHEY   = lf95
# More aggressive for production runs:
#FOPT_LAHEY = -Cpp --pca -O
# More checking for debugging:
FOPT_LAHEY = -Cpp --chk a,e,s,u --pca --ap -O0 -g --trap --trace --chkglobal

FC_INTEL   = ifort
# More aggressive for production runs:
#FOPT_INTEL = -cpp -O -fp-model precise -pc80 -prec_div
# More checking for debugging:
FOPT_INTEL = -cpp -O0 -fp-model strict -implicitnone -ftrapuv \
              -debug all -check all -warn all -g

FC_PGF     = pgf90
# More aggressive for production runs:
FOPT_PGF   = -Mpreprocess -O -fast -pc 80 -Kieee
# More checking for debugging:
#FOPT_PGF   = -Mpreprocess -O0 -Mbounds -Mchkfpstk -Mchkptr -Mchkstk \
#             -Ktrap=fp -pc 80 -Kieee

FC_HPUX    = f90
FOPT_HPUX  = -O -u +Oall +check=on

FC_GFORTRAN     = gfortran
FOPT_GFORTRAN   = -cpp -O -g -frecursive

# define FULL_ALGEBRA for non-sparse integration
FC   = $(FC_$(COMPILER))
FOPT = $(FOPT_$(COMPILER)) # -DFULL_ALGEBRA

LIBS =
#LIBS = -llapack -lblas

#############################################################################
# Test if various files are found on disk or not
# so that we can include/exclude them from the Make process
#############################################################################

# JacobianSP
HAS_JAC_SP =0
ifeq ($(shell test -f RACM_JacobianSP.f90 && echo y),y)
  HAS_JAC_SP =1
endif

# Jacobian
HAS_JAC = 0
ifeq ($(shell test -f RACM_Jacobian.f90 && echo y),y)
  HAS_JAC = 1
endif

# HessianSP
HAS_HES_SP = 0
ifeq ($(shell test -f RACM_HessianSP.f90 && echo y),y)
  HAS_HES_SP = 1
endif

# Hessian
HAS_HES=0
ifeq ($(shell test -f RACM_Hessian.f90 && echo y),y)
  HAS_HES = 1
endif

# StoichiomSP
HAS_STM_SP = 0
ifeq ($(shell test -f  RACM_StoichiomSP.f90 && echo y),y)
  HAS_STM_SP=1
endif

# Stoichiom
HAS_STM = 0
ifeq ($(shell test -f  RACM_Stoichiom.f90 && echo y),y)
  HAS_STM=1
endif

# If an external rates module has been supplied,
# also define the correspoinding object file
ifdef EXTERNAL_RATES_F90
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_F90:.f90=.o)
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_OBJ:.F90=.o)
endif

#############################################################################
# Construct lists of objects and sources
#############################################################################

# Command to create Matlab mex gateway routines
# Note: use $(FC) as the mex Fortran compiler
MEX  = mex

# NOTE: Allow for an external module to be USE-d by F90_Rates
# by specifying the relevant environment variables.
GENSRC = RACM_Precision.f90  RACM_Parameters.f90  \
         RACM_Global.f90     $(EXTERNAL_RATES_F90)
GENOBJ = RACM_Precision.o    RACM_Parameters.o    \
         RACM_Global.o       $(EXTERNAL_RATES_OBJ)

FUNSRC = RACM_Function.f90
FUNOBJ = RACM_Function.o

JACSRC   =
JACOBJ   =
JACSPOBJ =
ifeq ($(HAS_JAC_SP),1)
  JACSRC   += RACM_JacobianSP.f90
  JACOBJ   += RACM_JacobianSP.o
  JACSPOBJ += RACM_JacobianSP.o
endif
ifeq ($(HAS_JAC),1)
  JACSRC   += RACM_Jacobian.f90
  JACOBJ   += RACM_Jacobian.o
endif

HESSRC   =
HESOBJ   =
HESSPOBJ =
ifeq ($(HAS_HES_SP),1)
  HESSRC   += RACM_HessianSP.f90
  HESOBJ   += RACM_HessianSP.o
  HESSPOBJ += RACM_HessianSP.o
endif
ifeq ($(HAS_HES),1)
  HESSRC   += RACM_Hessian.f90
  HESOBJ   += RACM_Hessian.o
endif

STMSRC   =
STMOBJ   =
STMSPOBJ =
ifeq ($(HAS_STM_SP),1)
  STMSRC   += RACM_StoichiomSP.f90
  STMOBJ   += RACM_StoichiomSP.o
  STMSPOBJ += RACM_StoichiomSP.o
endif
ifeq ($(HAS_HES),1)
  HESSRC   += RACM_Stoichiom.f90
  HESOBJ   += RACM_Stoichiom.o
endif

UTLSRC = RACM_Rates.f90 RACM_Util.f90 RACM_Monitor.f90
UTLOBJ = RACM_Rates.o   RACM_Util.o   RACM_Monitor.o

LASRC  = RACM_LinearAlgebra.f90
LAOBJ  = RACM_LinearAlgebra.o

STOCHSRC = RACM_Stochastic.f90
STOCHOBJ = RACM_Stochastic.o

MAINSRC = RACM_Main.f90        RACM_Initialize.f90 \
          RACM_Integrator.f90  RACM_Model.f90
MAINOBJ = RACM_Main.o          RACM_Initialize.o   \
          RACM_Integrator.o    RACM_Model.o

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       objects needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ALLOBJ = $(GENOBJ) $(FUNOBJ) $(JACOBJ) $(HESOBJ) $(STMOBJ) \
	 $(UTLOBJ) $(LAOBJ)

#############################################################################
# Makefile targets and rules
#############################################################################

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       executables needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
all:    exe

exe:	$(ALLOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(MAINOBJ) $(LIBS) -o RACM.exe

stochastic:$(ALLOBJ) $(STOCHOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(STOCHOBJ) $(MAINOBJ) $(LIBS) \
	-o RACM_stochastic.exe

mex:    $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O RACM_mex_Fun.f90     $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O RACM_mex_Jac_SP.f90  $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O RACM_mex_Hessian.f90 $(ALLOBJ)

clean:
	rm -f *.o *.mod \
	RACM*.dat RACM.exe RACM*.mexglx \
	RACM.log

distclean:
	rm -f *.o *.mod \
	RACM*.dat RACM.exe RACM.log \
	RACM_*.f90 RACM_*.f90 RACM_*.mexglx \
	results*.m *.dat

RACM_Precision.o: RACM_Precision.f90
	$(FC) $(FOPT) -c $<

RACM_Parameters.o: RACM_Parameters.f90 RACM_Precision.o
	$(FC) $(FOPT) -c $<

RACM_Monitor.o: RACM_Monitor.f90 RACM_Precision.o
	$(FC) $(FOPT) -c $<

RACM_Global.o: RACM_Global.f90 RACM_Parameters.o RACM_Precision.o
	$(FC) $(FOPT) -c $<

RACM_Initialize.o: RACM_Initialize.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

RACM_Function.o: RACM_Function.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

RACM_Stochastic.o: RACM_Stochastic.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

RACM_JacobianSP.o: RACM_JacobianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

RACM_Jacobian.o: RACM_Jacobian.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

RACM_LinearAlgebra.o: RACM_LinearAlgebra.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

RACM_Rates.o: RACM_Rates.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

RACM_HessianSP.o: RACM_HessianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

RACM_Hessian.o:  RACM_Hessian.f90 $(GENOBJ) $(HESSPOBJ)
	$(FC) $(FOPT) -c $<

RACM_StoichiomSP.o: RACM_StoichiomSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

RACM_Stoichiom.o: RACM_Stoichiom.f90 $(GENOBJ) $(STMSPOBJ)
	$(FC) $(FOPT) -c $<

RACM_Util.o: RACM_Util.f90 $(GENOBJ) RACM_Monitor.o
	$(FC) $(FOPT) -c $<

RACM_Main.o: RACM_Main.f90  $(ALLOBJ) \
                 RACM_Initialize.o RACM_Model.o RACM_Integrator.o
	$(FC) $(FOPT) -c $<

RACM_Model.o: RACM_Model.f90 $(ALLOBJ) RACM_Integrator.o
	$(FC) $(FOPT) -c $<

RACM_Integrator.o: RACM_Integrator.f90 $(ALLOBJ)
	$(FC) $(FOPT) -c $<

# Define rule for a user-defined module that gets USE-d by F90_Rates.
# This rule is only applied if both variables are not blank.
ifdef EXTERNAL_RATES_F90
ifdef EXTERNAL_RATES_OBJ
$(EXTERNAL_RATES_OBJ): $(EXTERNAL_RATES_F90) RACM_Precision.o RACM_Global.o RACM_Parameters.o
	$(FC) $(FOPT) -c $<
endif
endif

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: Set here the F90 compiler and options
#       Pedefined compilers: INTEL, PGF, HPUX, LAHEY
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Pick a default compiler if not supplied
ifndef COMPILER
#COMPILER = LAHEY
#COMPILER = INTEL
#COMPILER = PGF
#COMPILER = HPUX
COMPILER = GFORTRAN
endif

FC_LAHEY   = lf95
# More aggressive for production runs:
#FOPT_LAHEY = -Cpp --pca -O
# More checking for debugging:
FOPT_LAHEY = -Cpp --chk a,e,s,u --pca --ap -O0 -g --trap --trace --chkglobal

FC_INTEL   = ifort
# More aggressive for production runs:
#FOPT_INTEL = -cpp -O -fp-model precise -pc80 -prec_div
# More checking for debugging:
FOPT_INTEL = -cpp -O0 -fp-model strict -implicitnone -ftrapuv \
              -debug all -check all -warn all -g

FC_PGF     = pgf90
# More aggressive for production runs:
FOPT_PGF   = -Mpreprocess -O -fast -pc 80 -Kieee
# More checking for debugging:
#FOPT_PGF   = -Mpreprocess -O0 -Mbounds -Mchkfpstk -Mchkptr -Mchkstk \
#             -Ktrap=fp -pc 80 -Kieee

FC_HPUX    = f90
FOPT_HPUX  = -O -u +Oall +check=on

FC_GFORTRAN     = gfortran
FOPT_GFORTRAN   = -cpp -O -g -frecursive

# define FULL_ALGEBRA for non-sparse integration
FC   = $(FC_$(COMPILER))
FOPT = $(FOPT_$(COMPILER)) # -DFULL_ALGEBRA

LIBS =
#LIBS = -llapack -lblas

#############################################################################
# Test if various files are found on disk or not
# so that we can include/exclude them from the Make process
#############################################################################

# JacobianSP
HAS_JAC_SP =0
ifeq ($(shell test -f RADM2_JacobianSP.f90 && echo y),y)
  HAS_JAC_SP =1
endif

# Jacobian
HAS_JAC = 0
ifeq ($(shell test -f RADM2_Jacobian.f90 && echo y),y)
  HAS_JAC = 1
endif

# HessianSP
HAS_HES_SP = 0
ifeq ($(shell test -f RADM2_HessianSP.f90 && echo y),y)
  HAS_HES_SP = 1
endif

# Hessian
HAS_HES=0
ifeq ($(shell test -f RADM2_Hessian.f90 && echo y),y)
  HAS_HES = 1
endif

# StoichiomSP
HAS_STM_SP = 0
ifeq ($(shell test -f  RADM2_StoichiomSP.f90 && echo y),y)
  HAS_STM_SP=1
endif

# Stoichiom
HAS_STM = 0
ifeq ($(shell test -f  RADM2_Stoichiom.f90 && echo y),y)
  HAS_STM=1
endif

# If an external rates module has been supplied,
# also define the correspoinding object file
ifdef EXTERNAL_RATES_F90
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_F90:.f90=.o)
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_OBJ:.F90=.o)
endif

#############################################################################
# Construct lists of objects and sources
#############################################################################

# Command to create Matlab mex gateway routines
# Note: use $(FC) as the mex Fortran compiler
MEX  = mex

# NOTE: Allow for an external module to be USE-d by F90_Rates
# by specifying the relevant environment variables.
GENSRC = RADM2_Precision.f90  RADM2_Parameters.f90  \
         RADM2_Global.f90     $(EXTERNAL_RATES_F90)
GENOBJ = RADM2_Precision.o    RADM2_Parameters.o    \
         RADM2_Global.o       $(EXTERNAL_RATES_OBJ)

FUNSRC = RADM2_Function.f90
FUNOBJ = RADM2_Function.o

JACSRC   =
JACOBJ   =
JACSPOBJ =
ifeq ($(HAS_JAC_SP),1)
  JACSRC   += RADM2_JacobianSP.f90
  JACOBJ   += RADM2_JacobianSP.o
  JACSPOBJ += RADM2_JacobianSP.o
endif
ifeq ($(HAS_JAC),1)
  JACSRC   += RADM2_Jacobian.f90
  JACOBJ   += RADM2_Jacobian.o
endif

HESSRC   =
HESOBJ   =
HESSPOBJ =
ifeq ($(HAS_HES_SP),1)
  HESSRC   += RADM2_HessianSP.f90
  HESOBJ   += RADM2_HessianSP.o
  HESSPOBJ += RADM2_HessianSP.o
endif
ifeq ($(HAS_HES),1)
  HESSRC   += RADM2_Hessian.f90
  HESOBJ   += RADM2_Hessian.o
endif

STMSRC   =
STMOBJ   =
STMSPOBJ =
ifeq ($(HAS_STM_SP),1)
  STMSRC   += RADM2_StoichiomSP.f90
  STMOBJ   += RADM2_StoichiomSP.o
  STMSPOBJ += RADM2_StoichiomSP.o
endif
ifeq ($(HAS_STM),1)
  STMSRC   += RADM2_Stoichiom.f90
  STMOBJ   += RADM2_Stoichiom.o
endif

UTLSRC = RADM2_Rates.f90 RADM2_Util.f90 RADM2_Monitor.f90
UTLOBJ = RADM2_Rates.o   RADM2_Util.o   RADM2_Monitor.o

LASRC  = RADM2_LinearAlgebra.f90
LAOBJ  = RADM2_LinearAlgebra.o

STOCHSRC = RADM2_Stochastic.f90
STOCHOBJ = RADM2_Stochastic.o

MAINSRC = RADM2_Main.f90        RADM2_Initialize.f90 \
          RADM2_Integrator.f90  RADM2_Model.f90
MAINOBJ = RADM2_Main.o          RADM2_Initialize.o   \
          RADM2_Integrator.o    RADM2_Model.o

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       objects needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ALLOBJ = $(GENOBJ) $(FUNOBJ) $(JACOBJ) $(HESOBJ) $(STMOBJ) \
	 $(UTLOBJ) $(LAOBJ)

#############################################################################
# Makefile targets and rules
#############################################################################

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       executables needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
all:    exe

exe:	$(ALLOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(MAINOBJ) $(LIBS) -o RADM2.exe

stochastic:$(ALLOBJ) $(STOCHOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(STOCHOBJ) $(MAINOBJ) $(LIBS) \
	-o RADM2_stochastic.exe

mex:    $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O RADM2_mex_Fun.f90     $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O RADM2_mex_Jac_SP.f90  $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O RADM2_mex_Hessian.f90 $(ALLOBJ)

clean:
	rm -f *.o *.mod \
	RADM2*.dat RADM2.exe RADM2*.mexglx \
	RADM2.log *.csv

distclean:
	rm -f *.o *.mod \
	RADM2*.dat RADM2.exe RADM2.log \
	RADM2_*.f90 RADM2_*.f90 RADM2_*.mexglx \
	results*.m *.dat *.csv

RADM2_Precision.o: RADM2_Precision.f90
	$(FC) $(FOPT) -c $<

RADM2_Parameters.o: RADM2_Parameters.f90 RADM2_Precision.o
	$(FC) $(FOPT) -c $<

RADM2_Monitor.o: RADM2_Monitor.f90 RADM2_Precision.o
	$(FC) $(FOPT) -c $<

RADM2_Global.o: RADM2_Global.f90 RADM2_Parameters.o RADM2_Precision.o
	$(FC) $(FOPT) -c $<

RADM2_Initialize.o: RADM2_Initialize.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

RADM2_Function.o: RADM2_Function.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

RADM2_Stochastic.o: RADM2_Stochastic.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

RADM2_JacobianSP.o: RADM2_JacobianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

RADM2_Jacobian.o: RADM2_Jacobian.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

RADM2_LinearAlgebra.o: RADM2_LinearAlgebra.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

RADM2_Rates.o: RADM2_Rates.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

RADM2_HessianSP.o: RADM2_HessianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

RADM2_Hessian.o:  RADM2_Hessian.f90 $(GENOBJ) $(HESSPOBJ)
	$(FC) $(FOPT) -c $<

RADM2_StoichiomSP.o: RADM2_StoichiomSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

RADM2_Stoichiom.o: RADM2_Stoichiom.f90 $(GENOBJ) $(STMSPOBJ)
	$(FC) $(FOPT) -c $<

RADM2_Util.o: RADM2_Util.f90 $(GENOBJ) RADM2_Monitor.o
	$(FC) $(FOPT) -c $<

RADM2_Main.o: RADM2_Main.f90  $(ALLOBJ) \
                 RADM2_Initialize.o RADM2_Model.o RADM2_Integrator.o
	$(FC) $(FOPT) -c $<

RADM2_Model.o: RADM2_Model.f90 $(ALLOBJ) RADM2_Integrator.o
	$(FC) $(FOPT) -c $<

RADM2_Integrator.o: RADM2_Integrator.f90 $(ALLOBJ)
	$(FC) $(FOPT) -c $<

# Define rule for a user-defined module that gets USE-d by F90_Rates.
# This rule is only applied if both variables are not blank.
ifdef EXTERNAL_RATES_F90
ifdef EXTERNAL_RATES_OBJ
$(EXTERNAL_RATES_OBJ): $(EXTERNAL_RATES_F90) RADM2_Precision.o RADM2_Global.o RADM2_Parameters.o
	$(FC) $(FOPT) -c $<
endif
endif

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: Set here the F90 compiler and options
#       Pedefined compilers: INTEL, PGF, HPUX, LAHEY
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Pick a default compiler if not supplied
ifndef COMPILER
#COMPILER = LAHEY
#COMPILER = INTEL
#COMPILER = PGF
#COMPILER = HPUX
COMPILER = GFORTRAN
endif

FC_LAHEY   = lf95
# More aggressive for production runs:
#FOPT_LAHEY = -Cpp --pca -O
# More checking for debugging:
FOPT_LAHEY = -Cpp --chk a,e,s,u --pca --ap -O0 -g --trap --trace --chkglobal

FC_INTEL   = ifort
# More aggressive for production runs:
#FOPT_INTEL = -cpp -O -fp-model precise -pc80 -prec_div
# More checking for debugging:
FOPT_INTEL = -cpp -O0 -fp-model strict -implicitnone -ftrapuv \
              -debug all -check all -warn all -g

FC_PGF     = pgf90
# More aggressive for production runs:
FOPT_PGF   = -Mpreprocess -O -fast -pc 80 -Kieee
# More checking for debugging:
#FOPT_PGF   = -Mpreprocess -O0 -Mbounds -Mchkfpstk -Mchkptr -Mchkstk \
#             -Ktrap=fp -pc 80 -Kieee

FC_HPUX    = f90
FOPT_HPUX  = -O -u +Oall +check=on

FC_GFORTRAN     = gfortran
FOPT_GFORTRAN   = -cpp -O -g -frecursive

# define FULL_ALGEBRA for non-sparse integration
FC   = $(FC_$(COMPILER))
FOPT = $(FOPT_$(COMPILER)) # -DFULL_ALGEBRA

LIBS =
#LIBS = -llapack -lblas

#############################################################################
# Test if various files are found on disk or not
# so that we can include/exclude them from the Make process
#############################################################################

# JacobianSP
HAS_JAC_SP =0
ifeq ($(shell test -f gas_JacobianSP.f90 && echo y),y)
  HAS_JAC_SP =1
endif

# Jacobian
HAS_JAC = 0
ifeq ($(shell test -f gas_Jacobian.f90 && echo y),y)
  HAS_JAC = 1
endif

# HessianSP
HAS_HES_SP = 0
ifeq ($(shell test -f gas_HessianSP.f90 && echo y),y)
  HAS_HES_SP = 1
endif

# Hessian
HAS_HES=0
ifeq ($(shell test -f gas_Hessian.f90 && echo y),y)
  HAS_HES = 1
endif

# StoichiomSP
HAS_STM_SP = 0
ifeq ($(shell test -f  gas_StoichiomSP.f90 && echo y),y)
  HAS_STM_SP=1
endif

# Stoichiom
HAS_STM = 0
ifeq ($(shell test -f  gas_Stoichiom.f90 && echo y),y)
  HAS_STM=1
endif

# If an external rates module has been supplied,
# also define the correspoinding object file
ifdef EXTERNAL_RATES_F90
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_F90:.f90=.o)
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_OBJ:.F90=.o)
endif

#############################################################################
# Construct lists of objects and sources
#############################################################################

# Command to create Matlab mex gateway routines
# Note: use $(FC) as the mex Fortran compiler
MEX  = mex

# NOTE: Allow for an external module to be USE-d by F90_Rates
# by specifying the relevant environment variables.
GENSRC = gas_Precision.f90  gas_Parameters.f90  \
         gas_Global.f90     $(EXTERNAL_RATES_F90)
GENOBJ = gas_Precision.o    gas_Parameters.o    \
         gas_Global.o       $(EXTERNAL_RATES_OBJ)

FUNSRC = gas_Function.f90
FUNOBJ = gas_Function.o

JACSRC   =
JACOBJ   =
JACSPOBJ =
ifeq ($(HAS_JAC_SP),1)
  JACSRC   += gas_JacobianSP.f90
  JACOBJ   += gas_JacobianSP.o
  JACSPOBJ += gas_JacobianSP.o
endif
ifeq ($(HAS_JAC),1)
  JACSRC   += gas_Jacobian.f90
  JACOBJ   += gas_Jacobian.o
endif

HESSRC   =
HESOBJ   =
HESSPOBJ =
ifeq ($(HAS_HES_SP),1)
  HESSRC   += gas_HessianSP.f90
  HESOBJ   += gas_HessianSP.o
  HESSPOBJ += gas_HessianSP.o
endif
ifeq ($(HAS_HES),1)
  HESSRC   += gas_Hessian.f90
  HESOBJ   += gas_Hessian.o
endif

STMSRC   =
STMOBJ   =
STMSPOBJ =
ifeq ($(HAS_STM_SP),1)
  STMSRC   += gas_StoichiomSP.f90
  STMOBJ   += gas_StoichiomSP.o
  STMSPOBJ += gas_StoichiomSP.o
endif
ifeq ($(HAS_HES),1)
  HESSRC   += gas_Stoichiom.f90
  HESOBJ   += gas_Stoichiom.o
endif

UTLSRC = gas_Rates.f90 gas_Util.f90 gas_Monitor.f90
UTLOBJ = gas_Rates.o   gas_Util.o   gas_Monitor.o

LASRC  = gas_LinearAlgebra.f90
LAOBJ  = gas_LinearAlgebra.o

STOCHSRC = gas_Stochastic.f90
STOCHOBJ = gas_Stochastic.o

MAINSRC = gas_Main.f90        gas_Initialize.f90 \
          gas_Integrator.f90  gas_Model.f90
MAINOBJ = gas_Main.o          gas_Initialize.o   \
          gas_Integrator.o    gas_Model.o

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       objects needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ALLOBJ = $(GENOBJ) $(FUNOBJ) $(JACOBJ) $(HESOBJ) $(STMOBJ) \
	 $(UTLOBJ) $(LAOBJ)

#############################################################################
# Makefile targets and rules
#############################################################################

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       executables needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
all:    exe

exe:	$(ALLOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(MAINOBJ) $(LIBS) -o gas.exe

stochastic:$(ALLOBJ) $(STOCHOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(STOCHOBJ) $(MAINOBJ) $(LIBS) \
	-o gas_stochastic.exe

mex:    $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O gas_mex_Fun.f90     $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O gas_mex_Jac_SP.f90  $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O gas_mex_Hessian.f90 $(ALLOBJ)

clean:
	rm -f *.o *.mod \
	gas*.dat gas.exe gas*.mexglx \
	gas.log

distclean:
	rm -f *.o *.mod \
	gas*.dat gas.exe gas.log \
	gas_*.f90 gas_*.f90 gas_*.mexglx \
	results*.m *.dat

gas_Precision.o: gas_Precision.f90
	$(FC) $(FOPT) -c $<

gas_Parameters.o: gas_Parameters.f90 gas_Precision.o
	$(FC) $(FOPT) -c $<

gas_Monitor.o: gas_Monitor.f90 gas_Precision.o
	$(FC) $(FOPT) -c $<

gas_Global.o: gas_Global.f90 gas_Parameters.o gas_Precision.o
	$(FC) $(FOPT) -c $<

gas_Initialize.o: gas_Initialize.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

gas_Function.o: gas_Function.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

gas_Stochastic.o: gas_Stochastic.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

gas_JacobianSP.o: gas_JacobianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

gas_Jacobian.o: gas_Jacobian.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

gas_LinearAlgebra.o: gas_LinearAlgebra.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

gas_Rates.o: gas_Rates.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

gas_HessianSP.o: gas_HessianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

gas_Hessian.o:  gas_Hessian.f90 $(GENOBJ) $(HESSPOBJ)
	$(FC) $(FOPT) -c $<

gas_StoichiomSP.o: gas_StoichiomSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

gas_Stoichiom.o: gas_Stoichiom.f90 $(GENOBJ) $(STMSPOBJ)
	$(FC) $(FOPT) -c $<

gas_Util.o: gas_Util.f90 $(GENOBJ) gas_Monitor.o
	$(FC) $(FOPT) -c $<

gas_Main.o: gas_Main.f90  $(ALLOBJ) \
                 gas_Initialize.o gas_Model.o gas_Integrator.o
	$(FC) $(FOPT) -c $<

gas_Model.o: gas_Model.f90 $(ALLOBJ) gas_Integrator.o
	$(FC) $(FOPT) -c $<

gas_Integrator.o: gas_Integrator.f90 $(ALLOBJ)
	$(FC) $(FOPT) -c $<

# Define rule for a user-defined module that gets USE-d by F90_Rates.
# This rule is only applied if both variables are not blank.
ifdef EXTERNAL_RATES_F90
ifdef EXTERNAL_RATES_OBJ
$(EXTERNAL_RATES_OBJ): $(EXTERNAL_RATES_F90) gas_Precision.o gas_Global.o gas_Parameters.o
	$(FC) $(FOPT) -c $<
endif
endif

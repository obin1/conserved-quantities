#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: Set here the F90 compiler and options
#       Pedefined compilers: INTEL, PGF, HPUX, LAHEY
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Pick a default compiler if not supplied
ifndef COMPILER
#COMPILER = LAHEY
#COMPILER = INTEL
#COMPILER = PGF
#COMPILER = HPUX
COMPILER = GFORTRAN
endif

FC_LAHEY   = lf95
# More aggressive for production runs:
#FOPT_LAHEY = -Cpp --pca -O
# More checking for debugging:
FOPT_LAHEY = -Cpp --chk a,e,s,u --pca --ap -O0 -g --trap --trace --chkglobal

FC_INTEL   = ifort
# More aggressive for production runs:
#FOPT_INTEL = -cpp -O -fp-model precise -pc80 -prec_div
# More checking for debugging:
FOPT_INTEL = -cpp -O0 -fp-model strict -implicitnone -ftrapuv \
              -debug all -check all -warn all -g

FC_PGF     = pgf90
# More aggressive for production runs:
FOPT_PGF   = -Mpreprocess -O -fast -pc 80 -Kieee
# More checking for debugging:
#FOPT_PGF   = -Mpreprocess -O0 -Mbounds -Mchkfpstk -Mchkptr -Mchkstk \
#             -Ktrap=fp -pc 80 -Kieee

FC_HPUX    = f90
FOPT_HPUX  = -O -u +Oall +check=on

FC_GFORTRAN     = gfortran
FOPT_GFORTRAN   = -cpp -O -g -frecursive

# define FULL_ALGEBRA for non-sparse integration
FC   = $(FC_$(COMPILER))
FOPT = $(FOPT_$(COMPILER)) # -DFULL_ALGEBRA

LIBS =
#LIBS = -llapack -lblas

#############################################################################
# Test if various files are found on disk or not
# so that we can include/exclude them from the Make process
#############################################################################

# JacobianSP
HAS_JAC_SP =0
ifeq ($(shell test -f superfast_JacobianSP.f90 && echo y),y)
  HAS_JAC_SP =1
endif

# Jacobian
HAS_JAC = 0
ifeq ($(shell test -f superfast_Jacobian.f90 && echo y),y)
  HAS_JAC = 1
endif

# HessianSP
HAS_HES_SP = 0
ifeq ($(shell test -f superfast_HessianSP.f90 && echo y),y)
  HAS_HES_SP = 1
endif

# Hessian
HAS_HES=0
ifeq ($(shell test -f superfast_Hessian.f90 && echo y),y)
  HAS_HES = 1
endif

# StoichiomSP
HAS_STM_SP = 0
ifeq ($(shell test -f  superfast_StoichiomSP.f90 && echo y),y)
  HAS_STM_SP=1
endif

# Stoichiom
HAS_STM = 0
ifeq ($(shell test -f  superfast_Stoichiom.f90 && echo y),y)
  HAS_STM=1
endif

# If an external rates module has been supplied,
# also define the correspoinding object file
ifdef EXTERNAL_RATES_F90
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_F90:.f90=.o)
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_OBJ:.F90=.o)
endif

#############################################################################
# Construct lists of objects and sources
#############################################################################

# Command to create Matlab mex gateway routines
# Note: use $(FC) as the mex Fortran compiler
MEX  = mex

# NOTE: Allow for an external module to be USE-d by F90_Rates
# by specifying the relevant environment variables.
GENSRC = superfast_Precision.f90  superfast_Parameters.f90  \
         superfast_Global.f90     $(EXTERNAL_RATES_F90)
GENOBJ = superfast_Precision.o    superfast_Parameters.o    \
         superfast_Global.o       $(EXTERNAL_RATES_OBJ)

FUNSRC = superfast_Function.f90
FUNOBJ = superfast_Function.o

JACSRC   =
JACOBJ   =
JACSPOBJ =
ifeq ($(HAS_JAC_SP),1)
  JACSRC   += superfast_JacobianSP.f90
  JACOBJ   += superfast_JacobianSP.o
  JACSPOBJ += superfast_JacobianSP.o
endif
ifeq ($(HAS_JAC),1)
  JACSRC   += superfast_Jacobian.f90
  JACOBJ   += superfast_Jacobian.o
endif

HESSRC   =
HESOBJ   =
HESSPOBJ =
ifeq ($(HAS_HES_SP),1)
  HESSRC   += superfast_HessianSP.f90
  HESOBJ   += superfast_HessianSP.o
  HESSPOBJ += superfast_HessianSP.o
endif
ifeq ($(HAS_HES),1)
  HESSRC   += superfast_Hessian.f90
  HESOBJ   += superfast_Hessian.o
endif

STMSRC   =
STMOBJ   =
STMSPOBJ =
ifeq ($(HAS_STM_SP),1)
  STMSRC   += superfast_StoichiomSP.f90
  STMOBJ   += superfast_StoichiomSP.o
  STMSPOBJ += superfast_StoichiomSP.o
endif
ifeq ($(HAS_STM),1)
  STMSRC   += superfast_Stoichiom.f90
  STMOBJ   += superfast_Stoichiom.o
endif

UTLSRC = superfast_Rates.f90 superfast_Util.f90 superfast_Monitor.f90
UTLOBJ = superfast_Rates.o   superfast_Util.o   superfast_Monitor.o

LASRC  = superfast_LinearAlgebra.f90
LAOBJ  = superfast_LinearAlgebra.o

STOCHSRC = superfast_Stochastic.f90
STOCHOBJ = superfast_Stochastic.o

MAINSRC = superfast_Main.f90        superfast_Initialize.f90 \
          superfast_Integrator.f90  superfast_Model.f90
MAINOBJ = superfast_Main.o          superfast_Initialize.o   \
          superfast_Integrator.o    superfast_Model.o

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       objects needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ALLOBJ = $(GENOBJ) $(FUNOBJ) $(JACOBJ) $(HESOBJ) $(STMOBJ) \
	 $(UTLOBJ) $(LAOBJ)

#############################################################################
# Makefile targets and rules
#############################################################################

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       executables needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
all:    exe

exe:	$(ALLOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(MAINOBJ) $(LIBS) -o superfast.exe

stochastic:$(ALLOBJ) $(STOCHOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(STOCHOBJ) $(MAINOBJ) $(LIBS) \
	-o superfast_stochastic.exe

mex:    $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O superfast_mex_Fun.f90     $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O superfast_mex_Jac_SP.f90  $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O superfast_mex_Hessian.f90 $(ALLOBJ)

clean:
	rm -f *.o *.mod \
	superfast*.dat superfast.exe superfast*.mexglx \
	superfast.log *.csv

distclean:
	rm -f *.o *.mod \
	superfast*.dat superfast.exe superfast.log \
	superfast_*.f90 superfast_*.f90 superfast_*.mexglx \
	results*.m *.dat *.csv

superfast_Precision.o: superfast_Precision.f90
	$(FC) $(FOPT) -c $<

superfast_Parameters.o: superfast_Parameters.f90 superfast_Precision.o
	$(FC) $(FOPT) -c $<

superfast_Monitor.o: superfast_Monitor.f90 superfast_Precision.o
	$(FC) $(FOPT) -c $<

superfast_Global.o: superfast_Global.f90 superfast_Parameters.o superfast_Precision.o
	$(FC) $(FOPT) -c $<

superfast_Initialize.o: superfast_Initialize.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

superfast_Function.o: superfast_Function.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

superfast_Stochastic.o: superfast_Stochastic.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

superfast_JacobianSP.o: superfast_JacobianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

superfast_Jacobian.o: superfast_Jacobian.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

superfast_LinearAlgebra.o: superfast_LinearAlgebra.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

superfast_Rates.o: superfast_Rates.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

superfast_HessianSP.o: superfast_HessianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

superfast_Hessian.o:  superfast_Hessian.f90 $(GENOBJ) $(HESSPOBJ)
	$(FC) $(FOPT) -c $<

superfast_StoichiomSP.o: superfast_StoichiomSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

superfast_Stoichiom.o: superfast_Stoichiom.f90 $(GENOBJ) $(STMSPOBJ)
	$(FC) $(FOPT) -c $<

superfast_Util.o: superfast_Util.f90 $(GENOBJ) superfast_Monitor.o
	$(FC) $(FOPT) -c $<

superfast_Main.o: superfast_Main.f90  $(ALLOBJ) \
                 superfast_Initialize.o superfast_Model.o superfast_Integrator.o
	$(FC) $(FOPT) -c $<

superfast_Model.o: superfast_Model.f90 $(ALLOBJ) superfast_Integrator.o
	$(FC) $(FOPT) -c $<

superfast_Integrator.o: superfast_Integrator.f90 $(ALLOBJ)
	$(FC) $(FOPT) -c $<

# Define rule for a user-defined module that gets USE-d by F90_Rates.
# This rule is only applied if both variables are not blank.
ifdef EXTERNAL_RATES_F90
ifdef EXTERNAL_RATES_OBJ
$(EXTERNAL_RATES_OBJ): $(EXTERNAL_RATES_F90) superfast_Precision.o superfast_Global.o superfast_Parameters.o
	$(FC) $(FOPT) -c $<
endif
endif

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: Set here the F90 compiler and options
#       Pedefined compilers: INTEL, PGF, HPUX, LAHEY
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Pick a default compiler if not supplied
ifndef COMPILER
#COMPILER = LAHEY
#COMPILER = INTEL
#COMPILER = PGF
#COMPILER = HPUX
COMPILER = GFORTRAN
endif

FC_LAHEY   = lf95
# More aggressive for production runs:
#FOPT_LAHEY = -Cpp --pca -O
# More checking for debugging:
FOPT_LAHEY = -Cpp --chk a,e,s,u --pca --ap -O0 -g --trap --trace --chkglobal

FC_INTEL   = ifort
# More aggressive for production runs:
#FOPT_INTEL = -cpp -O -fp-model precise -pc80 -prec_div
# More checking for debugging:
FOPT_INTEL = -cpp -O0 -fp-model strict -implicitnone -ftrapuv \
              -debug all -check all -warn all -g

FC_PGF     = pgf90
# More aggressive for production runs:
FOPT_PGF   = -Mpreprocess -O -fast -pc 80 -Kieee
# More checking for debugging:
#FOPT_PGF   = -Mpreprocess -O0 -Mbounds -Mchkfpstk -Mchkptr -Mchkstk \
#             -Ktrap=fp -pc 80 -Kieee

FC_HPUX    = f90
FOPT_HPUX  = -O -u +Oall +check=on

FC_GFORTRAN     = gfortran
FOPT_GFORTRAN   = -cpp -O -g -frecursive

# define FULL_ALGEBRA for non-sparse integration
FC   = $(FC_$(COMPILER))
FOPT = $(FOPT_$(COMPILER)) # -DFULL_ALGEBRA

LIBS =
#LIBS = -llapack -lblas

#############################################################################
# Test if various files are found on disk or not
# so that we can include/exclude them from the Make process
#############################################################################

# JacobianSP
HAS_JAC_SP =0
ifeq ($(shell test -f jam_JacobianSP.f90 && echo y),y)
  HAS_JAC_SP =1
endif

# Jacobian
HAS_JAC = 0
ifeq ($(shell test -f jam_Jacobian.f90 && echo y),y)
  HAS_JAC = 1
endif

# HessianSP
HAS_HES_SP = 0
ifeq ($(shell test -f jam_HessianSP.f90 && echo y),y)
  HAS_HES_SP = 1
endif

# Hessian
HAS_HES=0
ifeq ($(shell test -f jam_Hessian.f90 && echo y),y)
  HAS_HES = 1
endif

# StoichiomSP
HAS_STM_SP = 0
ifeq ($(shell test -f  jam_StoichiomSP.f90 && echo y),y)
  HAS_STM_SP=1
endif

# Stoichiom
HAS_STM = 0
ifeq ($(shell test -f  jam_Stoichiom.f90 && echo y),y)
  HAS_STM=1
endif

# If an external rates module has been supplied,
# also define the correspoinding object file
ifdef EXTERNAL_RATES_F90
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_F90:.f90=.o)
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_OBJ:.F90=.o)
endif

#############################################################################
# Construct lists of objects and sources
#############################################################################

# Command to create Matlab mex gateway routines
# Note: use $(FC) as the mex Fortran compiler
MEX  = mex

# NOTE: Allow for an external module to be USE-d by F90_Rates
# by specifying the relevant environment variables.
GENSRC = jam_Precision.f90  jam_Parameters.f90  \
         jam_Global.f90     $(EXTERNAL_RATES_F90)
GENOBJ = jam_Precision.o    jam_Parameters.o    \
         jam_Global.o       $(EXTERNAL_RATES_OBJ)

FUNSRC = jam_Function.f90
FUNOBJ = jam_Function.o

JACSRC   =
JACOBJ   =
JACSPOBJ =
ifeq ($(HAS_JAC_SP),1)
  JACSRC   += jam_JacobianSP.f90
  JACOBJ   += jam_JacobianSP.o
  JACSPOBJ += jam_JacobianSP.o
endif
ifeq ($(HAS_JAC),1)
  JACSRC   += jam_Jacobian.f90
  JACOBJ   += jam_Jacobian.o
endif

HESSRC   =
HESOBJ   =
HESSPOBJ =
ifeq ($(HAS_HES_SP),1)
  HESSRC   += jam_HessianSP.f90
  HESOBJ   += jam_HessianSP.o
  HESSPOBJ += jam_HessianSP.o
endif
ifeq ($(HAS_HES),1)
  HESSRC   += jam_Hessian.f90
  HESOBJ   += jam_Hessian.o
endif

STMSRC   =
STMOBJ   =
STMSPOBJ =
ifeq ($(HAS_STM_SP),1)
  STMSRC   += jam_StoichiomSP.f90
  STMOBJ   += jam_StoichiomSP.o
  STMSPOBJ += jam_StoichiomSP.o
endif
ifeq ($(HAS_HES),1)
  HESSRC   += jam_Stoichiom.f90
  HESOBJ   += jam_Stoichiom.o
endif

UTLSRC = jam_Rates.f90 jam_Util.f90 jam_Monitor.f90
UTLOBJ = jam_Rates.o   jam_Util.o   jam_Monitor.o

LASRC  = jam_LinearAlgebra.f90
LAOBJ  = jam_LinearAlgebra.o

STOCHSRC = jam_Stochastic.f90
STOCHOBJ = jam_Stochastic.o

MAINSRC = jam_Main.f90        jam_Initialize.f90 \
          jam_Integrator.f90  jam_Model.f90
MAINOBJ = jam_Main.o          jam_Initialize.o   \
          jam_Integrator.o    jam_Model.o

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       objects needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ALLOBJ = $(GENOBJ) $(FUNOBJ) $(JACOBJ) $(HESOBJ) $(STMOBJ) \
	 $(UTLOBJ) $(LAOBJ)

#############################################################################
# Makefile targets and rules
#############################################################################

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       executables needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
all:    exe

exe:	$(ALLOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(MAINOBJ) $(LIBS) -o jam.exe

stochastic:$(ALLOBJ) $(STOCHOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(STOCHOBJ) $(MAINOBJ) $(LIBS) \
	-o jam_stochastic.exe

mex:    $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O jam_mex_Fun.f90     $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O jam_mex_Jac_SP.f90  $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O jam_mex_Hessian.f90 $(ALLOBJ)

clean:
	rm -f *.o *.mod \
	jam*.dat jam.exe jam*.mexglx \
	jam.log

distclean:
	rm -f *.o *.mod \
	jam*.dat jam.exe jam.log \
	jam_*.f90 jam_*.f90 jam_*.mexglx \
	results*.m *.dat

jam_Precision.o: jam_Precision.f90
	$(FC) $(FOPT) -c $<

jam_Parameters.o: jam_Parameters.f90 jam_Precision.o
	$(FC) $(FOPT) -c $<

jam_Monitor.o: jam_Monitor.f90 jam_Precision.o
	$(FC) $(FOPT) -c $<

jam_Global.o: jam_Global.f90 jam_Parameters.o jam_Precision.o
	$(FC) $(FOPT) -c $<

jam_Initialize.o: jam_Initialize.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

jam_Function.o: jam_Function.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

jam_Stochastic.o: jam_Stochastic.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

jam_JacobianSP.o: jam_JacobianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

jam_Jacobian.o: jam_Jacobian.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

jam_LinearAlgebra.o: jam_LinearAlgebra.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

jam_Rates.o: jam_Rates.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

jam_HessianSP.o: jam_HessianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

jam_Hessian.o:  jam_Hessian.f90 $(GENOBJ) $(HESSPOBJ)
	$(FC) $(FOPT) -c $<

jam_StoichiomSP.o: jam_StoichiomSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

jam_Stoichiom.o: jam_Stoichiom.f90 $(GENOBJ) $(STMSPOBJ)
	$(FC) $(FOPT) -c $<

jam_Util.o: jam_Util.f90 $(GENOBJ) jam_Monitor.o
	$(FC) $(FOPT) -c $<

jam_Main.o: jam_Main.f90  $(ALLOBJ) \
                 jam_Initialize.o jam_Model.o jam_Integrator.o
	$(FC) $(FOPT) -c $<

jam_Model.o: jam_Model.f90 $(ALLOBJ) jam_Integrator.o
	$(FC) $(FOPT) -c $<

jam_Integrator.o: jam_Integrator.f90 $(ALLOBJ)
	$(FC) $(FOPT) -c $<

# Define rule for a user-defined module that gets USE-d by F90_Rates.
# This rule is only applied if both variables are not blank.
ifdef EXTERNAL_RATES_F90
ifdef EXTERNAL_RATES_OBJ
$(EXTERNAL_RATES_OBJ): $(EXTERNAL_RATES_F90) jam_Precision.o jam_Global.o jam_Parameters.o
	$(FC) $(FOPT) -c $<
endif
endif

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: Set here the F90 compiler and options
#       Pedefined compilers: INTEL, PGF, HPUX, LAHEY
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Pick a default compiler if not supplied
ifndef COMPILER
#COMPILER = LAHEY
#COMPILER = INTEL
#COMPILER = PGF
#COMPILER = HPUX
COMPILER = GFORTRAN
endif

FC_LAHEY   = lf95
# More aggressive for production runs:
#FOPT_LAHEY = -Cpp --pca -O
# More checking for debugging:
FOPT_LAHEY = -Cpp --chk a,e,s,u --pca --ap -O0 -g --trap --trace --chkglobal

FC_INTEL   = ifort
# More aggressive for production runs:
#FOPT_INTEL = -cpp -O -fp-model precise -pc80 -prec_div
# More checking for debugging:
FOPT_INTEL = -cpp -O0 -fp-model strict -implicitnone -ftrapuv \
              -debug all -check all -warn all -g

FC_PGF     = pgf90
# More aggressive for production runs:
FOPT_PGF   = -Mpreprocess -O -fast -pc 80 -Kieee
# More checking for debugging:
#FOPT_PGF   = -Mpreprocess -O0 -Mbounds -Mchkfpstk -Mchkptr -Mchkstk \
#             -Ktrap=fp -pc 80 -Kieee

FC_HPUX    = f90
FOPT_HPUX  = -O -u +Oall +check=on

FC_GFORTRAN     = gfortran
FOPT_GFORTRAN   = -cpp -O -g -frecursive

# define FULL_ALGEBRA for non-sparse integration
FC   = $(FC_$(COMPILER))
FOPT = $(FOPT_$(COMPILER)) # -DFULL_ALGEBRA

LIBS =
#LIBS = -llapack -lblas

#############################################################################
# Test if various files are found on disk or not
# so that we can include/exclude them from the Make process
#############################################################################

# JacobianSP
HAS_JAC_SP =0
ifeq ($(shell test -f isoprene_full_v5_JacobianSP.f90 && echo y),y)
  HAS_JAC_SP =1
endif

# Jacobian
HAS_JAC = 0
ifeq ($(shell test -f isoprene_full_v5_Jacobian.f90 && echo y),y)
  HAS_JAC = 1
endif

# HessianSP
HAS_HES_SP = 0
ifeq ($(shell test -f isoprene_full_v5_HessianSP.f90 && echo y),y)
  HAS_HES_SP = 1
endif

# Hessian
HAS_HES=0
ifeq ($(shell test -f isoprene_full_v5_Hessian.f90 && echo y),y)
  HAS_HES = 1
endif

# StoichiomSP
HAS_STM_SP = 0
ifeq ($(shell test -f  isoprene_full_v5_StoichiomSP.f90 && echo y),y)
  HAS_STM_SP=1
endif

# Stoichiom
HAS_STM = 0
ifeq ($(shell test -f  isoprene_full_v5_Stoichiom.f90 && echo y),y)
  HAS_STM=1
endif

# If an external rates module has been supplied,
# also define the correspoinding object file
ifdef EXTERNAL_RATES_F90
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_F90:.f90=.o)
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_OBJ:.F90=.o)
endif

#############################################################################
# Construct lists of objects and sources
#############################################################################

# Command to create Matlab mex gateway routines
# Note: use $(FC) as the mex Fortran compiler
MEX  = mex

# NOTE: Allow for an external module to be USE-d by F90_Rates
# by specifying the relevant environment variables.
GENSRC = isoprene_full_v5_Precision.f90  isoprene_full_v5_Parameters.f90  \
         isoprene_full_v5_Global.f90     $(EXTERNAL_RATES_F90)
GENOBJ = isoprene_full_v5_Precision.o    isoprene_full_v5_Parameters.o    \
         isoprene_full_v5_Global.o       $(EXTERNAL_RATES_OBJ)

FUNSRC = isoprene_full_v5_Function.f90
FUNOBJ = isoprene_full_v5_Function.o

JACSRC   =
JACOBJ   =
JACSPOBJ =
ifeq ($(HAS_JAC_SP),1)
  JACSRC   += isoprene_full_v5_JacobianSP.f90
  JACOBJ   += isoprene_full_v5_JacobianSP.o
  JACSPOBJ += isoprene_full_v5_JacobianSP.o
endif
ifeq ($(HAS_JAC),1)
  JACSRC   += isoprene_full_v5_Jacobian.f90
  JACOBJ   += isoprene_full_v5_Jacobian.o
endif

HESSRC   =
HESOBJ   =
HESSPOBJ =
ifeq ($(HAS_HES_SP),1)
  HESSRC   += isoprene_full_v5_HessianSP.f90
  HESOBJ   += isoprene_full_v5_HessianSP.o
  HESSPOBJ += isoprene_full_v5_HessianSP.o
endif
ifeq ($(HAS_HES),1)
  HESSRC   += isoprene_full_v5_Hessian.f90
  HESOBJ   += isoprene_full_v5_Hessian.o
endif

STMSRC   =
STMOBJ   =
STMSPOBJ =
ifeq ($(HAS_STM_SP),1)
  STMSRC   += isoprene_full_v5_StoichiomSP.f90
  STMOBJ   += isoprene_full_v5_StoichiomSP.o
  STMSPOBJ += isoprene_full_v5_StoichiomSP.o
endif
ifeq ($(HAS_STM),1)
  STMSRC   += isoprene_full_v5_Stoichiom.f90
  STMOBJ   += isoprene_full_v5_Stoichiom.o
endif

UTLSRC = isoprene_full_v5_Rates.f90 isoprene_full_v5_Util.f90 isoprene_full_v5_Monitor.f90
UTLOBJ = isoprene_full_v5_Rates.o   isoprene_full_v5_Util.o   isoprene_full_v5_Monitor.o

LASRC  = isoprene_full_v5_LinearAlgebra.f90
LAOBJ  = isoprene_full_v5_LinearAlgebra.o

STOCHSRC = isoprene_full_v5_Stochastic.f90
STOCHOBJ = isoprene_full_v5_Stochastic.o

MAINSRC = isoprene_full_v5_Main.f90        isoprene_full_v5_Initialize.f90 \
          isoprene_full_v5_Integrator.f90  isoprene_full_v5_Model.f90
MAINOBJ = isoprene_full_v5_Main.o          isoprene_full_v5_Initialize.o   \
          isoprene_full_v5_Integrator.o    isoprene_full_v5_Model.o

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       objects needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ALLOBJ = $(GENOBJ) $(FUNOBJ) $(JACOBJ) $(HESOBJ) $(STMOBJ) \
	 $(UTLOBJ) $(LAOBJ)

#############################################################################
# Makefile targets and rules
#############################################################################

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       executables needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
all:    exe

exe:	$(ALLOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(MAINOBJ) $(LIBS) -o isoprene_full_v5.exe

stochastic:$(ALLOBJ) $(STOCHOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(STOCHOBJ) $(MAINOBJ) $(LIBS) \
	-o isoprene_full_v5_stochastic.exe

mex:    $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O isoprene_full_v5_mex_Fun.f90     $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O isoprene_full_v5_mex_Jac_SP.f90  $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O isoprene_full_v5_mex_Hessian.f90 $(ALLOBJ)

clean:
	rm -f *.o *.mod \
	isoprene_full_v5*.dat isoprene_full_v5.exe isoprene_full_v5*.mexglx \
	isoprene_full_v5.log *.csv

distclean:
	rm -f *.o *.mod \
	isoprene_full_v5*.dat isoprene_full_v5.exe isoprene_full_v5.log \
	isoprene_full_v5_*.f90 isoprene_full_v5_*.f90 isoprene_full_v5_*.mexglx \
	results*.m *.dat *.csv

isoprene_full_v5_Precision.o: isoprene_full_v5_Precision.f90
	$(FC) $(FOPT) -c $<

isoprene_full_v5_Parameters.o: isoprene_full_v5_Parameters.f90 isoprene_full_v5_Precision.o
	$(FC) $(FOPT) -c $<

isoprene_full_v5_Monitor.o: isoprene_full_v5_Monitor.f90 isoprene_full_v5_Precision.o
	$(FC) $(FOPT) -c $<

isoprene_full_v5_Global.o: isoprene_full_v5_Global.f90 isoprene_full_v5_Parameters.o isoprene_full_v5_Precision.o
	$(FC) $(FOPT) -c $<

isoprene_full_v5_Initialize.o: isoprene_full_v5_Initialize.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

isoprene_full_v5_Function.o: isoprene_full_v5_Function.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

isoprene_full_v5_Stochastic.o: isoprene_full_v5_Stochastic.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

isoprene_full_v5_JacobianSP.o: isoprene_full_v5_JacobianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

isoprene_full_v5_Jacobian.o: isoprene_full_v5_Jacobian.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

isoprene_full_v5_LinearAlgebra.o: isoprene_full_v5_LinearAlgebra.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

isoprene_full_v5_Rates.o: isoprene_full_v5_Rates.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

isoprene_full_v5_HessianSP.o: isoprene_full_v5_HessianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

isoprene_full_v5_Hessian.o:  isoprene_full_v5_Hessian.f90 $(GENOBJ) $(HESSPOBJ)
	$(FC) $(FOPT) -c $<

isoprene_full_v5_StoichiomSP.o: isoprene_full_v5_StoichiomSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

isoprene_full_v5_Stoichiom.o: isoprene_full_v5_Stoichiom.f90 $(GENOBJ) $(STMSPOBJ)
	$(FC) $(FOPT) -c $<

isoprene_full_v5_Util.o: isoprene_full_v5_Util.f90 $(GENOBJ) isoprene_full_v5_Monitor.o
	$(FC) $(FOPT) -c $<

isoprene_full_v5_Main.o: isoprene_full_v5_Main.f90  $(ALLOBJ) \
                 isoprene_full_v5_Initialize.o isoprene_full_v5_Model.o isoprene_full_v5_Integrator.o
	$(FC) $(FOPT) -c $<

isoprene_full_v5_Model.o: isoprene_full_v5_Model.f90 $(ALLOBJ) isoprene_full_v5_Integrator.o
	$(FC) $(FOPT) -c $<

isoprene_full_v5_Integrator.o: isoprene_full_v5_Integrator.f90 $(ALLOBJ)
	$(FC) $(FOPT) -c $<

# Define rule for a user-defined module that gets USE-d by F90_Rates.
# This rule is only applied if both variables are not blank.
ifdef EXTERNAL_RATES_F90
ifdef EXTERNAL_RATES_OBJ
$(EXTERNAL_RATES_OBJ): $(EXTERNAL_RATES_F90) isoprene_full_v5_Precision.o isoprene_full_v5_Global.o isoprene_full_v5_Parameters.o
	$(FC) $(FOPT) -c $<
endif
endif

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: Set here the F90 compiler and options
#       Pedefined compilers: INTEL, PGF, HPUX, LAHEY
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Pick a default compiler if not supplied
ifndef COMPILER
#COMPILER = LAHEY
#COMPILER = INTEL
#COMPILER = PGF
#COMPILER = HPUX
COMPILER = GFORTRAN
endif

FC_LAHEY   = lf95
# More aggressive for production runs:
#FOPT_LAHEY = -Cpp --pca -O
# More checking for debugging:
FOPT_LAHEY = -Cpp --chk a,e,s,u --pca --ap -O0 -g --trap --trace --chkglobal

FC_INTEL   = ifort
# More aggressive for production runs:
#FOPT_INTEL = -cpp -O -fp-model precise -pc80 -prec_div
# More checking for debugging:
FOPT_INTEL = -cpp -O0 -fp-model strict -implicitnone -ftrapuv \
              -debug all -check all -warn all -g

FC_PGF     = pgf90
# More aggressive for production runs:
FOPT_PGF   = -Mpreprocess -O -fast -pc 80 -Kieee
# More checking for debugging:
#FOPT_PGF   = -Mpreprocess -O0 -Mbounds -Mchkfpstk -Mchkptr -Mchkstk \
#             -Ktrap=fp -pc 80 -Kieee

FC_HPUX    = f90
FOPT_HPUX  = -O -u +Oall +check=on

FC_GFORTRAN     = gfortran
FOPT_GFORTRAN   = -cpp -O -g -frecursive

# define FULL_ALGEBRA for non-sparse integration
FC   = $(FC_$(COMPILER))
FOPT = $(FOPT_$(COMPILER)) # -DFULL_ALGEBRA

LIBS =
#LIBS = -llapack -lblas

#############################################################################
# Test if various files are found on disk or not
# so that we can include/exclude them from the Make process
#############################################################################

# JacobianSP
HAS_JAC_SP =0
ifeq ($(shell test -f mech_JacobianSP.f90 && echo y),y)
  HAS_JAC_SP =1
endif

# Jacobian
HAS_JAC = 0
ifeq ($(shell test -f mech_Jacobian.f90 && echo y),y)
  HAS_JAC = 1
endif

# HessianSP
HAS_HES_SP = 0
ifeq ($(shell test -f mech_HessianSP.f90 && echo y),y)
  HAS_HES_SP = 1
endif

# Hessian
HAS_HES=0
ifeq ($(shell test -f mech_Hessian.f90 && echo y),y)
  HAS_HES = 1
endif

# StoichiomSP
HAS_STM_SP = 0
ifeq ($(shell test -f  mech_StoichiomSP.f90 && echo y),y)
  HAS_STM_SP=1
endif

# Stoichiom
HAS_STM = 0
ifeq ($(shell test -f  mech_Stoichiom.f90 && echo y),y)
  HAS_STM=1
endif

# If an external rates module has been supplied,
# also define the correspoinding object file
ifdef EXTERNAL_RATES_F90
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_F90:.f90=.o)
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_OBJ:.F90=.o)
endif

#############################################################################
# Construct lists of objects and sources
#############################################################################

# Command to create Matlab mex gateway routines
# Note: use $(FC) as the mex Fortran compiler
MEX  = mex

# NOTE: Allow for an external module to be USE-d by F90_Rates
# by specifying the relevant environment variables.
GENSRC = mech_Precision.f90  mech_Parameters.f90  \
         mech_Global.f90     $(EXTERNAL_RATES_F90)
GENOBJ = mech_Precision.o    mech_Parameters.o    \
         mech_Global.o       $(EXTERNAL_RATES_OBJ)

FUNSRC = mech_Function.f90
FUNOBJ = mech_Function.o

JACSRC   =
JACOBJ   =
JACSPOBJ =
ifeq ($(HAS_JAC_SP),1)
  JACSRC   += mech_JacobianSP.f90
  JACOBJ   += mech_JacobianSP.o
  JACSPOBJ += mech_JacobianSP.o
endif
ifeq ($(HAS_JAC),1)
  JACSRC   += mech_Jacobian.f90
  JACOBJ   += mech_Jacobian.o
endif

HESSRC   =
HESOBJ   =
HESSPOBJ =
ifeq ($(HAS_HES_SP),1)
  HESSRC   += mech_HessianSP.f90
  HESOBJ   += mech_HessianSP.o
  HESSPOBJ += mech_HessianSP.o
endif
ifeq ($(HAS_HES),1)
  HESSRC   += mech_Hessian.f90
  HESOBJ   += mech_Hessian.o
endif

STMSRC   =
STMOBJ   =
STMSPOBJ =
ifeq ($(HAS_STM_SP),1)
  STMSRC   += mech_StoichiomSP.f90
  STMOBJ   += mech_StoichiomSP.o
  STMSPOBJ += mech_StoichiomSP.o
endif
ifeq ($(HAS_STM),1)
  STMSRC   += mech_Stoichiom.f90
  STMOBJ   += mech_Stoichiom.o
endif

UTLSRC = mech_Rates.f90 mech_Util.f90 mech_Monitor.f90
UTLOBJ = mech_Rates.o   mech_Util.o   mech_Monitor.o

LASRC  = mech_LinearAlgebra.f90
LAOBJ  = mech_LinearAlgebra.o

STOCHSRC = mech_Stochastic.f90
STOCHOBJ = mech_Stochastic.o

MAINSRC = mech_Main.f90        mech_Initialize.f90 \
          mech_Integrator.f90  mech_Model.f90
MAINOBJ = mech_Main.o          mech_Initialize.o   \
          mech_Integrator.o    mech_Model.o

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       objects needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ALLOBJ = $(GENOBJ) $(FUNOBJ) $(JACOBJ) $(HESOBJ) $(STMOBJ) \
	 $(UTLOBJ) $(LAOBJ)

#############################################################################
# Makefile targets and rules
#############################################################################

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       executables needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
all:    exe

exe:	$(ALLOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(MAINOBJ) $(LIBS) -o mech.exe

stochastic:$(ALLOBJ) $(STOCHOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(STOCHOBJ) $(MAINOBJ) $(LIBS) \
	-o mech_stochastic.exe

mex:    $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O mech_mex_Fun.f90     $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O mech_mex_Jac_SP.f90  $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O mech_mex_Hessian.f90 $(ALLOBJ)

clean:
	rm -f *.o *.mod \
	mech*.dat mech.exe mech*.mexglx \
	mech.log *.csv

distclean:
	rm -f *.o *.mod \
	mech*.dat mech.exe mech.log \
	mech_*.f90 mech_*.f90 mech_*.mexglx \
	results*.m *.dat *.csv

mech_Precision.o: mech_Precision.f90
	$(FC) $(FOPT) -c $<

mech_Parameters.o: mech_Parameters.f90 mech_Precision.o
	$(FC) $(FOPT) -c $<

mech_Monitor.o: mech_Monitor.f90 mech_Precision.o
	$(FC) $(FOPT) -c $<

mech_Global.o: mech_Global.f90 mech_Parameters.o mech_Precision.o
	$(FC) $(FOPT) -c $<

mech_Initialize.o: mech_Initialize.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

mech_Function.o: mech_Function.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

mech_Stochastic.o: mech_Stochastic.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

mech_JacobianSP.o: mech_JacobianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

mech_Jacobian.o: mech_Jacobian.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

mech_LinearAlgebra.o: mech_LinearAlgebra.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

mech_Rates.o: mech_Rates.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

mech_HessianSP.o: mech_HessianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

mech_Hessian.o:  mech_Hessian.f90 $(GENOBJ) $(HESSPOBJ)
	$(FC) $(FOPT) -c $<

mech_StoichiomSP.o: mech_StoichiomSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

mech_Stoichiom.o: mech_Stoichiom.f90 $(GENOBJ) $(STMSPOBJ)
	$(FC) $(FOPT) -c $<

mech_Util.o: mech_Util.f90 $(GENOBJ) mech_Monitor.o
	$(FC) $(FOPT) -c $<

mech_Main.o: mech_Main.f90  $(ALLOBJ) \
                 mech_Initialize.o mech_Model.o mech_Integrator.o
	$(FC) $(FOPT) -c $<

mech_Model.o: mech_Model.f90 $(ALLOBJ) mech_Integrator.o
	$(FC) $(FOPT) -c $<

mech_Integrator.o: mech_Integrator.f90 $(ALLOBJ)
	$(FC) $(FOPT) -c $<

# Define rule for a user-defined module that gets USE-d by F90_Rates.
# This rule is only applied if both variables are not blank.
ifdef EXTERNAL_RATES_F90
ifdef EXTERNAL_RATES_OBJ
$(EXTERNAL_RATES_OBJ): $(EXTERNAL_RATES_F90) mech_Precision.o mech_Global.o mech_Parameters.o
	$(FC) $(FOPT) -c $<
endif
endif

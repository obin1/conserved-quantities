#EQUATIONS
// All rate constants converted from  molec/cm3 to ppm
// and 1/sec to 1/min
// <R1> NO2 = NO + O  : RJCELL( IJ_NO2_SAPRC99 ) ;
 <R1> NO2 + hv = NO + O  : j('no2') ;
 <R2> O + O2 + M = O3  :  RFACTOR_SQU * ARRI(   6.0000D-34, 0.0000D+0, -2.4000D+00, TEMP) ;
 <R3> O3 + NO = NO2  :  RFACTOR * ARR2I(   3.0000D-12,  -1.5000D+03 , TEMP) ;
 <R4> O + NO2 = NO  :  RFACTOR * ARR2I(   5.6000D-12,   1.8000D+02 , TEMP) ;
 <R5> O + NO2 = NO3  :  RFACTOR * RKI_RXN_R5               ;
 <R6> O + NO = NO2  :  RFACTOR * RKI_RXN_R6               ;
 <R7> NO2 + O3 = NO3  :  RFACTOR * ARR2I(   1.2000D-13,  -2.4500D+03 , TEMP) ;
// <R8> O3 = O  : RJCELL( IJ_O3_O3P_IUPAC04 ) ;
 <R8> O3 + hv = O  : j('o33p');
// <R9> O3 = O1D  : RJCELL( IJ_O3_O1D_IUPAC04 ) ;
 <R9> O3 + hv = O1D  : j('o31d') ;
 <R10> O1D + M = O  :  RFACTOR * ARR2I(   2.1000D-11,   1.0200D+02 , TEMP) ;
 <R11> O1D + H2O = 2.00000*OH  :  RFACTOR *   2.2000D-10 ;
 <R12> O3 + OH = HO2  :  RFACTOR * ARR2I(   1.7000D-12,  -9.4000D+02 , TEMP) ;
 <R13> O3 + HO2 = OH  :  RFACTOR * ARR2I(   1.0000D-14,  -4.9000D+02 , TEMP) ;
// <R14> NO3 = NO2 + O  : RJCELL( IJ_NO3NO2_SAPRC99 ) ;
 <R14> NO3 + hv = NO2 + O  : j('no3o') ;
// <R15> NO3 = NO  : RJCELL( IJ_NO3NO_SAPRC99 ) ;
 <R15> NO3 + hv = NO  : j('no3o2') ;
 <R16> NO3 + NO = 2.00000*NO2  :  RFACTOR * ARR2I(   1.5000D-11,   1.7000D+02 , TEMP) ;
 <R17> NO3 + NO2 = NO + NO2  :  RFACTOR * ARR2I(   4.5000D-14,  -1.2600D+03 , TEMP) ;
 <R18> NO3 + NO2 = N2O5  :  RFACTOR * RKI_RXN_R18              ;
 <R19> N2O5 + H2O = 2.00000*HNO3  :  RFACTOR *   1.0000D-22 ;
 <R20> N2O5 + H2O + H2O = 2.00000*HNO3  :  RFACTOR_SQU *   0.0000D+00 ;
// <R21> N2O5 = NO3 + NO2  :  60.0D0 * RKI_RXN_R21              ;
 <R21> N2O5 = NO3 + NO2  :  RKI_RXN_R21              ;
 <R22> NO + NO + O2 = 2.00000*NO2  :  RFACTOR_SQU * ARR2I(   3.3000D-39,   5.3000D+02 , TEMP) ;
 <R23> NO + NO2 + H2O = 2.00000*HONO  :  RFACTOR_SQU *   5.0000D-40 ;
 <R24> NO + OH = HONO  :  RFACTOR * RKI_RXN_R24              ;
// <R25> HONO = NO + OH  : RJCELL( IJ_HONO_IUPAC04 ) ;
 <R25> HONO + hv = NO + OH  : j('hno2') ;
 <R26> OH + HONO = NO2  :  RFACTOR * ARR2I(   1.8000D-11,  -3.9000D+02 , TEMP) ;
 <R27> HONO + HONO = NO + NO2  :  RFACTOR *   1.0000D-20 ;
 <R28> NO2 + OH = HNO3  :  RFACTOR * RKI_RXN_R28              ;
 <R29> OH + HNO3 = NO3  :  RFACTOR * EP2( 2.4D-14, -4.6D+02, 2.7D-17, -2.199D+03, 6.5D-34, -1.3350D+03, TEMP, C_M ) ;
 <R30> HO2 + NO = OH + NO2  :  RFACTOR * ARR2I(   3.5000D-12,   2.5000D+02 , TEMP) ;
 <R31> HO2 + NO2 = PNA  :  RFACTOR * RKI_RXN_R31              ;
// <R32> PNA = HO2 + NO2  :  60.0D0 * RKI_RXN_R32              ;
 <R32> PNA = HO2 + NO2  :  RKI_RXN_R32              ;
 <R33> OH + PNA = NO2  :  RFACTOR * ARR2I(   1.3000D-12,   3.8000D+02 , TEMP) ;
 <R34> HO2 + HO2 = H2O2  :  RFACTOR * EP3(   2.3000D-13,  -6.0000D+02,   1.7000D-33,  -1.0000D+03, TEMP, C_M ) ;
 <R35> HO2 + HO2 + H2O = H2O2  :  RFACTOR_SQU * EP3(   3.2200D-34,  -2.8000D+03,   2.3800D-54,  -3.2000D+03, TEMP, C_M ) ;
// <R36> H2O2 = 2.00000*OH  : RJCELL( IJ_H2O2_SAPRC99 ) ;
 <R36> H2O2 + hv = 2.00000*OH  : j('h2o2') ;
 <R37> OH + H2O2 = HO2  :  RFACTOR * ARR2I(   2.9000D-12,  -1.6000D+02 , TEMP) ;
 <R38> O1D + H2 = OH + HO2  :  RFACTOR *   1.1000D-10 ;
 <R39> OH + H2 = HO2  :  RFACTOR * ARR2I(   5.5000D-12,  -2.0000D+03 , TEMP) ;
 <R40> OH + O = HO2  :  RFACTOR * ARR2I(   2.2000D-11,   1.2000D+02 , TEMP) ;
 <R41> OH + OH = O  :  RFACTOR * ARR2I(   4.2000D-12,  -2.4000D+02 , TEMP) ;
 <R42> OH + OH = H2O2  :  RFACTOR * RKI_RXN_R42              ;
 <R43> OH + HO2 = DUMMY   :  RFACTOR * ARR2I(   4.8000D-11,   2.5000D+02 , TEMP) ;
 <R44> HO2 + O = OH  :  RFACTOR * ARR2I(   3.0000D-11,   2.0000D+02 , TEMP) ;
 <R45> H2O2 + O = OH + HO2  :  RFACTOR * ARR2I(   1.4000D-12,  -2.0000D+03 , TEMP) ;
 <R46> NO3 + O = NO2  :  RFACTOR *   1.0000D-11 ;
 <R47> NO3 + OH = HO2 + NO2  :  RFACTOR *   2.2000D-11 ;
 <R48> NO3 + HO2 = HNO3  :  RFACTOR *   3.5000D-12 ;
 <R49> NO3 + O3 = NO2  :  RFACTOR *   1.0000D-17 ;
 <R50> NO3 + NO3 = 2.00000*NO2  :  RFACTOR * ARR2I(   8.5000D-13,  -2.4500D+03 , TEMP) ;
// <R51> PNA = 0.61000*HO2 +  0.61000*NO2 +  0.39000*OH +  0.39000*NO3  : RJCELL( IJ_HO2NO2_IUPAC04 ) ;
 <R51> PNA + hv = 0.61000*HO2 +  0.61000*NO2 +  0.39000*OH +  0.39000*NO3  : j('hno4');
// <R52> HNO3 = OH + NO2  : RJCELL( IJ_HNO3_IUPAC04 ) ;
 <R52> HNO3 + hv = OH + NO2  : j('hno3') ;
// <R53> N2O5 = NO2 + NO3 + DUMMY  : RJCELL( IJ_N2O5_IUPAC04 ) ;
 <R53> N2O5 + hv = NO2 + NO3 + DUMMY  : j('n2o5') ;
 <R54> XO2 + NO = NO2  :  RFACTOR * ARR2I(   2.6000D-12,   3.6500D+02 , TEMP) ;
 <R55> XO2N + NO = NTR  :  RFACTOR * ARR2I(   2.6000D-12,   3.6500D+02 , TEMP) ;
 <R56> XO2 + HO2 = ROOH  :  RFACTOR * ARR2I(   7.5000D-13,   7.0000D+02 , TEMP) ;
 <R57> XO2N + HO2 = ROOH  :  RFACTOR * ARR2I(   7.5000D-13,   7.0000D+02 , TEMP) ;
 <R58> XO2 + XO2 = DUMMY   :  RFACTOR *   6.8000D-14 ;
 <R59> XO2N + XO2N = DUMMY   :  RFACTOR *   6.8000D-14 ;
 <R60> XO2 + XO2N = DUMMY   :  RFACTOR *   6.8000D-14 ;
 <R61> NTR + OH = HNO3 + HO2 +  0.33000*FORM +  0.33000*ALD2 +  0.33000*ALDX
               -0.66000*PAR  :  RFACTOR * ARR2I(   5.9000D-13,  -3.6000D+02 , TEMP) ;
// <R62> NTR = NO2 + HO2 +  0.33000*FORM +  0.33000*ALD2 +  0.33000*ALDX
//               -0.66000*PAR  : RJCELL( IJ_NTR_IUPAC04 ) ;
 <R62> NTR + hv = NO2 + HO2 +  0.33000*FORM +  0.33000*ALD2 +  0.33000*ALDX
               -0.66000*PAR  : j('ntr'); ;
 <R63> ROOH + OH = XO2 +  0.50000*ALD2 +  0.50000*ALDX  :  RFACTOR * ARR2I(   3.0100D-12,   1.9000D+02 , TEMP) ;
// <R64> ROOH = OH + HO2 +  0.50000*ALD2 +  0.50000*ALDX  : RJCELL( IJ_COOH_SAPRC99 ) ;
 <R64> ROOH + hv = OH + HO2 +  0.50000*ALD2 +  0.50000*ALDX  : j('cooh') ;
 <R65> OH + CO = HO2  :  RFACTOR * EP3(   1.4400D-13,   0.0000D+00,   3.4300D-33,   0.0000D+00, TEMP, C_M ) ;
 <R66> OH + CH4 = MEO2  :  RFACTOR * ARR2I(   2.4500D-12,  -1.7750D+03 , TEMP) ;
 <R67> MEO2 + NO = FORM + HO2 + NO2  :  RFACTOR * ARR2I(   2.8000D-12,   3.0000D+02 , TEMP) ;
 <R68> MEO2 + HO2 = MEPX  :  RFACTOR * ARR2I(   4.1000D-13,   7.5000D+02 , TEMP) ;
 <R69> MEO2 + MEO2 = 1.37000*FORM +  0.74000*HO2 +  0.63000*MEOH  :  RFACTOR * ARR2I(   9.5000D-14,   3.9000D+02 , TEMP) ;
 <R70> MEPX + OH = 0.70000*MEO2 +  0.30000*XO2 +  0.30000*HO2  :  RFACTOR * ARR2I(   3.8000D-12,   2.0000D+02 , TEMP) ;
// <R71> MEPX = FORM + HO2 + OH  : RJCELL( IJ_COOH_SAPRC99 ) ;
 <R71> MEPX + hv = FORM + HO2 + OH  : j('cooh') ;
 <R72> MEOH + OH = FORM + HO2  :  RFACTOR * ARR2I(   7.3000D-12,  -6.2000D+02 , TEMP) ;
 <R73> FORM + OH = HO2 + CO  :  RFACTOR *   9.0000D-12 ;
// <R74> FORM = 2.00000*HO2 + CO  : RJCELL( IJ_HCHO_R_SAPRC99 ) ;
 <R74> FORM + hv = 2.00000*HO2 + CO  : j('ch2or') ;
// <R75> FORM = CO  : RJCELL( IJ_HCHO_M_SAPRC99 ) ;
 <R75> FORM + hv = CO  : j('ch2om') ;
 <R76> FORM + O = OH + HO2 + CO  :  RFACTOR * ARR2I(   3.4000D-11,  -1.6000D+03 , TEMP) ;
 <R77> FORM + NO3 = HNO3 + HO2 + CO  :  RFACTOR *   5.8000D-16 ;
 <R78> FORM + HO2 = HCO3  :  RFACTOR * ARR2I(   9.7000D-15,   6.2500D+02 , TEMP) ;
// <R79> HCO3 = FORM + HO2  :  60.0D0 * ARR2I(   2.4000D+12,  -7.0000D+03 , TEMP) ;
 <R79> HCO3 = FORM + HO2  :  ARR2I(   2.4000D+12,  -7.0000D+03 , TEMP) ;
 <R80> HCO3 + NO = FACD + NO2 + HO2  :  RFACTOR *   5.6000D-12 ;
 <R81> HCO3 + HO2 = MEPX  :  RFACTOR * ARR2I(   5.6000D-15,   2.3000D+03 , TEMP) ;
 <R82> FACD + OH = HO2  :  RFACTOR *   4.0000D-13 ;
 <R83> ALD2 + O = C2O3 + OH  :  RFACTOR * ARR2I(   1.8000D-11,  -1.1000D+03 , TEMP) ;
 <R84> ALD2 + OH = C2O3  :  RFACTOR * ARR2I(   5.6000D-12,   2.7000D+02 , TEMP) ;
 <R85> ALD2 + NO3 = C2O3 + HNO3  :  RFACTOR * ARR2I(   1.4000D-12,  -1.9000D+03 , TEMP) ;
// <R86> ALD2 = MEO2 + CO + HO2  : RJCELL( IJ_CCHO_R_SAPRC99 ) ;
 <R86> ALD2 + hv = MEO2 + CO + HO2  : j('ccho_r') ;
 <R87> C2O3 + NO = MEO2 + NO2  :  RFACTOR * ARR2I(   8.1000D-12,   2.7000D+02 , TEMP) ;
 <R88> C2O3 + NO2 = PAN  :  RFACTOR * RKI_RXN_R88              ;
// <R89> PAN = C2O3 + NO2  :  60.0D0 * RKI_RXN_R89              ;
 <R89> PAN = C2O3 + NO2  :  RKI_RXN_R89              ;
// <R90> PAN = C2O3 + NO2  + DUMMY   : RJCELL( IJ_PAN_IUPAC04 ) ;
 <R90> PAN + hv = C2O3 + NO2  + DUMMY   : j('pan') ;
 <R91> C2O3 + HO2 = 0.80000*PACD +  0.20000*AACD +  0.20000*O3  :  RFACTOR * ARR2I(   4.3000D-13,   1.0400D+03 , TEMP) ;
 <R92> C2O3 + MEO2 = 0.90000*MEO2 +  0.90000*HO2 + FORM +  0.10000*AACD  :  RFACTOR * ARR2I(   2.0000D-12,   5.0000D+02 , TEMP) ;
 <R93> C2O3 + XO2 = 0.90000*MEO2 +  0.10000*AACD  :  RFACTOR * ARR2I(   4.4000D-13,   1.0700D+03 , TEMP) ;
 <R94> C2O3 + C2O3 = 2.00000*MEO2  :  RFACTOR * ARR2I(   2.9000D-12,   5.0000D+02 , TEMP) ;
 <R95> PACD + OH = C2O3  :  RFACTOR * ARR2I(   4.0000D-13,   2.0000D+02 , TEMP) ;
// <R96> PACD = MEO2 + OH  : RJCELL( IJ_PACD_CB05 ) ;
 <R96> PACD + hv = MEO2 + OH  : j('pacd') ;
 <R97> AACD + OH = MEO2  :  RFACTOR * ARR2I(   4.0000D-13,   2.0000D+02 , TEMP) ;
 <R98> ALDX + O = CXO3 + OH  :  RFACTOR * ARR2I(   1.3000D-11,  -8.7000D+02 , TEMP) ;
 <R99> ALDX + OH = CXO3  :  RFACTOR * ARR2I(   5.1000D-12,   4.0500D+02 , TEMP) ;
 <R100> ALDX + NO3 = CXO3 + HNO3  :  RFACTOR *   6.5000D-15 ;
// <R101> ALDX = MEO2 + CO + HO2  : RJCELL( IJ_C2CHO_SAPRC99 ) ;
 <R101> ALDX + hv = MEO2 + CO + HO2  : j('c2cho') ;
 <R102> CXO3 + NO = ALD2 + NO2 + HO2 + XO2  :  RFACTOR * ARR2I(   6.7000D-12,   3.4000D+02 , TEMP) ;
 <R103> CXO3 + NO2 = PANX  :  RFACTOR * RKI_RXN_R103             ;
// <R104> PANX = CXO3 + NO2  :  60.0D0 * RKI_RXN_R104             ;
 <R104> PANX = CXO3 + NO2  :  RKI_RXN_R104             ;
// <R105> PANX = CXO3 + NO2  + DUMMY   : RJCELL( IJ_PAN_IUPAC04 ) ;
 <R105> PANX + hv = CXO3 + NO2  + DUMMY   : j('pan') ;
 <R106> PANX + OH = ALD2 + NO2  :  RFACTOR *   3.0000D-13 ;
 <R107> CXO3 + HO2 = 0.80000*PACD +  0.20000*AACD +  0.20000*O3  :  RFACTOR * ARR2I(   4.3000D-13,   1.0400D+03 , TEMP) ;
 <R108> CXO3 + MEO2 = 0.90000*ALD2 +  0.90000*XO2 + HO2 +  0.10000*AACD +  0.10000*FORM  :  RFACTOR * ARR2I(   2.0000D-12,   5.0000D+02 , TEMP) ;
 <R109> CXO3 + XO2 = 0.90000*ALD2 +  0.10000*AACD  :  RFACTOR * ARR2I(   4.4000D-13,   1.0700D+03 , TEMP) ;
 <R110> CXO3 + CXO3 = 2.00000*ALD2 +  2.00000*XO2 +  2.00000*HO2  :  RFACTOR * ARR2I(   2.9000D-12,   5.0000D+02 , TEMP) ;
 <R111> CXO3 + C2O3 = MEO2 + XO2 + HO2 + ALD2  :  RFACTOR * ARR2I(   2.9000D-12,   5.0000D+02 , TEMP) ;
 <R112> PAR + OH = 0.87000*XO2 +  0.13000*XO2N +  0.11000*HO2 +  0.06000*ALD2 - 0.11000*PAR
                +  0.76000*ROR +  0.05000*ALDX  :  RFACTOR *   8.1000D-13 ;
// <R113> ROR = 0.96000*XO2 +  0.60000*ALD2 +  0.94000*HO2 - 2.10000*PAR +  0.04000*XO2N
//                +  0.02000*ROR +  0.50000*ALDX  :  60.0D0 * ARR2I(   1.0000D+15,  -8.0000D+03 , TEMP) ;
 <R113> ROR = 0.96000*XO2 +  0.60000*ALD2 +  0.94000*HO2 - 2.10000*PAR +  0.04000*XO2N
                +  0.02000*ROR +  0.50000*ALDX  :  ARR2I(   1.0000D+15,  -8.0000D+03 , TEMP) ;
// <R114> ROR = HO2  :  60.0D0 *   1.6000D+03 ;
 <R114> ROR = HO2  :  1.6000D+03 ;
 <R115> ROR + NO2 = NTR  :  RFACTOR *   1.5000D-11 ;
 <R116> O + OLE = 0.20000*ALD2 +  0.30000*ALDX +  0.30000*HO2 +  0.20000*XO2 +  0.20000*CO
                +  0.20000*FORM +  0.01000*XO2N +  0.20000*PAR +  0.10000*OH  :  RFACTOR * ARR2I(   1.0000D-11,  -2.8000D+02 , TEMP) ;
 <R117> OH + OLE = 0.80000*FORM +  0.33000*ALD2 +  0.62000*ALDX +  0.80000*XO2 +  0.95000*HO2
                - 0.70000*PAR  :  RFACTOR *   3.2000D-11 ;
 <R118> O3 + OLE = 0.18000*ALD2 +  0.74000*FORM +  0.32000*ALDX +  0.22000*XO2 +  0.10000*OH
                +  0.33000*CO +  0.44000*HO2 - PAR  :  RFACTOR * ARR2I(   6.5000D-15,  -1.9000D+03 , TEMP) ;
 <R119> NO3 + OLE = NO2 + FORM +  0.91000*XO2 +  0.09000*XO2N +  0.56000*ALDX
                +  0.35000*ALD2 - PAR  :  RFACTOR * ARR2I(   7.0000D-13,  -2.1600D+03 , TEMP) ;
 <R120> O + ETH = FORM +  1.70000*HO2 + CO +  0.70000*XO2 +  0.30000*OH  :  RFACTOR * ARR2I(   1.0400D-11,  -7.9200D+02 , TEMP) ;
 <R121> OH + ETH = XO2 +  1.56000*FORM +  0.22000*ALDX + HO2  :  RFACTOR * RKI_RXN_R121             ;
 <R122> O3 + ETH = FORM +  0.63000*CO +  0.13000*HO2 +  0.13000*OH +  0.37000*FACD  :  RFACTOR * ARR2I(   1.2000D-14,  -2.6300D+03 , TEMP) ;
 <R123> NO3 + ETH = NO2 + XO2 +  2.00000*FORM  :  RFACTOR * ARR2I(   3.3000D-12,  -2.8800D+03 , TEMP) ;
 <R124> IOLE + O = 1.24000*ALD2 +  0.66000*ALDX +  0.10000*HO2 +  0.10000*XO2 +  0.10000*CO
                +  0.10000*PAR  :  RFACTOR *   2.3000D-11 ;
 <R125> IOLE + OH = 1.30000*ALD2 +  0.70000*ALDX + HO2 + XO2  :  RFACTOR * ARR2I(   1.0000D-11,   5.5000D+02 , TEMP) ;
 <R126> IOLE + O3 = 0.65000*ALD2 +  0.35000*ALDX +  0.25000*FORM +  0.25000*CO +  0.50000*O
                +  0.50000*OH +  0.50000*HO2  :  RFACTOR * ARR2I(   8.4000D-15,  -1.1000D+03 , TEMP) ;
 <R127> IOLE + NO3 = 1.18000*ALD2 +  0.64000*ALDX + HO2 + NO2  :  RFACTOR * ARR2I(   9.6000D-13,  -2.7000D+02 , TEMP) ;
 <R128> TOL + OH = 0.28000*HO2 +  0.10000*XO2 +  0.18000*CRES +  0.65000*TO2 +  0.07200*OH
                + TOLRO2  :  RFACTOR * ARR2I(   1.8000D-12,   3.5500D+02 , TEMP) ;
 <R129> TO2 + NO = 0.86000*NO2 +  1.20000*HO2 +  0.86000*OPEN +  0.14000*NTR +  0.52000*MGLY
                +  0.33600*FORM +  0.33600*CO  :  RFACTOR * ARR2I(   2.7000D-12,   3.6000D+02 , TEMP) ;
 <R130> TO2 + HO2 = DUMMY   :  RFACTOR * ARR2I(   1.9000D-13,   1.3000D+03 , TEMP) ;
 <R131> OH + CRES = 0.06000*CRO +  0.12000*XO2 +  1.12000*HO2 +  0.13000*OPEN +  0.73200*CAT1
                +  0.06000*CO +  0.06000*XO2N +  0.06000*FORM  :  RFACTOR * ARR2I(   1.7000D-12,   9.5000D+02 , TEMP) ;
 <R132> CRES + NO3 = 0.30000*CRO + HNO3 +  0.60000*XO2 +  0.36000*HO2 +  0.48000*ALDX
                +  0.24000*FORM +  0.24000*MGLY +  0.12000*OPEN +  0.10000*XO2N +  0.24000*CO  :  RFACTOR *   1.4000D-11 ;
 <R133> CRO + NO2 = CRON  :  RFACTOR *   2.1000D-12 ;
 <R134> CRO + HO2 = CRES  :  RFACTOR *   5.5000D-12 ;
 <R135> CRON + OH = CRNO  :  RFACTOR *   1.5300D-12 ;
 <R136> CRON + NO3 = CRNO + HNO3  :  RFACTOR *   3.8000D-12 ;
 <R137> CRNO + NO2 = 2.00000*NTR  :  RFACTOR *   2.1000D-12 ;
 <R138> CRNO + O3 = CRN2  :  RFACTOR *   2.8600D-13 ;
 <R139> CRN2 + NO = CRNO + NO2  :  RFACTOR * ARR2I(   2.5400D-12,   3.6000D+02 , TEMP) ;
 <R140> CRN2 + HO2 = CRPX  :  RFACTOR * ARR2I(   2.4000D-13,   1.3000D+03 , TEMP) ;
// <R141> CRPX = CRNO + OH  :   1.0000D-02 * RJCELL( IJ_NO2_SAPRC99 ) ;
 <R141> CRPX + hv = CRNO + OH  :   1.0000D-02 * j('no2') ;

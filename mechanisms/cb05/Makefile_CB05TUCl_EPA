#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: Set here the F90 compiler and options
#       Pedefined compilers: INTEL, PGF, HPUX, LAHEY
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Pick a default compiler if not supplied
ifndef COMPILER
#COMPILER = LAHEY
#COMPILER = INTEL
#COMPILER = PGF
#COMPILER = HPUX
COMPILER = GFORTRAN
endif

FC_LAHEY   = lf95
# More aggressive for production runs:
#FOPT_LAHEY = -Cpp --pca -O
# More checking for debugging:
FOPT_LAHEY = -Cpp --chk a,e,s,u --pca --ap -O0 -g --trap --trace --chkglobal

FC_INTEL   = ifort
# More aggressive for production runs:
#FOPT_INTEL = -cpp -O -fp-model precise -pc80 -prec_div
# More checking for debugging:
FOPT_INTEL = -cpp -O0 -fp-model strict -implicitnone -ftrapuv \
              -debug all -check all -warn all -g

FC_PGF     = pgf90
# More aggressive for production runs:
FOPT_PGF   = -Mpreprocess -O -fast -pc 80 -Kieee
# More checking for debugging:
#FOPT_PGF   = -Mpreprocess -O0 -Mbounds -Mchkfpstk -Mchkptr -Mchkstk \
#             -Ktrap=fp -pc 80 -Kieee

FC_HPUX    = f90
FOPT_HPUX  = -O -u +Oall +check=on

FC_GFORTRAN     = gfortran
FOPT_GFORTRAN   = -cpp -O -g -frecursive

# define FULL_ALGEBRA for non-sparse integration
FC   = $(FC_$(COMPILER))
FOPT = $(FOPT_$(COMPILER)) # -DFULL_ALGEBRA

LIBS =
#LIBS = -llapack -lblas

#############################################################################
# Test if various files are found on disk or not
# so that we can include/exclude them from the Make process
#############################################################################

# JacobianSP
HAS_JAC_SP =0
ifeq ($(shell test -f CB05TUCl_EPA_JacobianSP.f90 && echo y),y)
  HAS_JAC_SP =1
endif

# Jacobian
HAS_JAC = 0
ifeq ($(shell test -f CB05TUCl_EPA_Jacobian.f90 && echo y),y)
  HAS_JAC = 1
endif

# HessianSP
HAS_HES_SP = 0
ifeq ($(shell test -f CB05TUCl_EPA_HessianSP.f90 && echo y),y)
  HAS_HES_SP = 1
endif

# Hessian
HAS_HES=0
ifeq ($(shell test -f CB05TUCl_EPA_Hessian.f90 && echo y),y)
  HAS_HES = 1
endif

# StoichiomSP
HAS_STM_SP = 0
ifeq ($(shell test -f  CB05TUCl_EPA_StoichiomSP.f90 && echo y),y)
  HAS_STM_SP=1
endif

# Stoichiom
HAS_STM = 0
ifeq ($(shell test -f  CB05TUCl_EPA_Stoichiom.f90 && echo y),y)
  HAS_STM=1
endif

# If an external rates module has been supplied,
# also define the correspoinding object file
ifdef EXTERNAL_RATES_F90
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_F90:.f90=.o)
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_OBJ:.F90=.o)
endif

#############################################################################
# Construct lists of objects and sources
#############################################################################

# Command to create Matlab mex gateway routines
# Note: use $(FC) as the mex Fortran compiler
MEX  = mex

# NOTE: Allow for an external module to be USE-d by F90_Rates
# by specifying the relevant environment variables.
GENSRC = CB05TUCl_EPA_Precision.f90  CB05TUCl_EPA_Parameters.f90  \
         CB05TUCl_EPA_Global.f90     $(EXTERNAL_RATES_F90)
GENOBJ = CB05TUCl_EPA_Precision.o    CB05TUCl_EPA_Parameters.o    \
         CB05TUCl_EPA_Global.o       $(EXTERNAL_RATES_OBJ)

FUNSRC = CB05TUCl_EPA_Function.f90
FUNOBJ = CB05TUCl_EPA_Function.o

JACSRC   =
JACOBJ   =
JACSPOBJ =
ifeq ($(HAS_JAC_SP),1)
  JACSRC   += CB05TUCl_EPA_JacobianSP.f90
  JACOBJ   += CB05TUCl_EPA_JacobianSP.o
  JACSPOBJ += CB05TUCl_EPA_JacobianSP.o
endif
ifeq ($(HAS_JAC),1)
  JACSRC   += CB05TUCl_EPA_Jacobian.f90
  JACOBJ   += CB05TUCl_EPA_Jacobian.o
endif

HESSRC   =
HESOBJ   =
HESSPOBJ =
ifeq ($(HAS_HES_SP),1)
  HESSRC   += CB05TUCl_EPA_HessianSP.f90
  HESOBJ   += CB05TUCl_EPA_HessianSP.o
  HESSPOBJ += CB05TUCl_EPA_HessianSP.o
endif
ifeq ($(HAS_HES),1)
  HESSRC   += CB05TUCl_EPA_Hessian.f90
  HESOBJ   += CB05TUCl_EPA_Hessian.o
endif

STMSRC   =
STMOBJ   =
STMSPOBJ =
ifeq ($(HAS_STM_SP),1)
  STMSRC   += CB05TUCl_EPA_StoichiomSP.f90
  STMOBJ   += CB05TUCl_EPA_StoichiomSP.o
  STMSPOBJ += CB05TUCl_EPA_StoichiomSP.o
endif
ifeq ($(HAS_STM),1)
  STMSRC   += CB05TUCl_EPA_Stoichiom.f90
  STMOBJ   += CB05TUCl_EPA_Stoichiom.o
endif

UTLSRC = CB05TUCl_EPA_Rates.f90 CB05TUCl_EPA_Util.f90 CB05TUCl_EPA_Monitor.f90
UTLOBJ = CB05TUCl_EPA_Rates.o   CB05TUCl_EPA_Util.o   CB05TUCl_EPA_Monitor.o

LASRC  = CB05TUCl_EPA_LinearAlgebra.f90
LAOBJ  = CB05TUCl_EPA_LinearAlgebra.o

STOCHSRC = CB05TUCl_EPA_Stochastic.f90
STOCHOBJ = CB05TUCl_EPA_Stochastic.o

MAINSRC = CB05TUCl_EPA_Main.f90        CB05TUCl_EPA_Initialize.f90 \
          CB05TUCl_EPA_Integrator.f90  CB05TUCl_EPA_Model.f90
MAINOBJ = CB05TUCl_EPA_Main.o          CB05TUCl_EPA_Initialize.o   \
          CB05TUCl_EPA_Integrator.o    CB05TUCl_EPA_Model.o

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       objects needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ALLOBJ = $(GENOBJ) $(FUNOBJ) $(JACOBJ) $(HESOBJ) $(STMOBJ) \
	 $(UTLOBJ) $(LAOBJ)

#############################################################################
# Makefile targets and rules
#############################################################################

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       executables needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
all:    exe

exe:	$(ALLOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(MAINOBJ) $(LIBS) -o CB05TUCl_EPA.exe

stochastic:$(ALLOBJ) $(STOCHOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(STOCHOBJ) $(MAINOBJ) $(LIBS) \
	-o CB05TUCl_EPA_stochastic.exe

mex:    $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O CB05TUCl_EPA_mex_Fun.f90     $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O CB05TUCl_EPA_mex_Jac_SP.f90  $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O CB05TUCl_EPA_mex_Hessian.f90 $(ALLOBJ)

clean:
	rm -f *.o *.mod \
	CB05TUCl_EPA*.dat CB05TUCl_EPA.exe CB05TUCl_EPA*.mexglx \
	CB05TUCl_EPA.log *.csv

distclean:
	rm -f *.o *.mod \
	CB05TUCl_EPA*.dat CB05TUCl_EPA.exe CB05TUCl_EPA.log \
	CB05TUCl_EPA_*.f90 CB05TUCl_EPA_*.f90 CB05TUCl_EPA_*.mexglx \
	results*.m *.dat *.csv

CB05TUCl_EPA_Precision.o: CB05TUCl_EPA_Precision.f90
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_Parameters.o: CB05TUCl_EPA_Parameters.f90 CB05TUCl_EPA_Precision.o
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_Monitor.o: CB05TUCl_EPA_Monitor.f90 CB05TUCl_EPA_Precision.o
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_Global.o: CB05TUCl_EPA_Global.f90 CB05TUCl_EPA_Parameters.o CB05TUCl_EPA_Precision.o
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_Initialize.o: CB05TUCl_EPA_Initialize.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_Function.o: CB05TUCl_EPA_Function.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_Stochastic.o: CB05TUCl_EPA_Stochastic.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_JacobianSP.o: CB05TUCl_EPA_JacobianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_Jacobian.o: CB05TUCl_EPA_Jacobian.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_LinearAlgebra.o: CB05TUCl_EPA_LinearAlgebra.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_Rates.o: CB05TUCl_EPA_Rates.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_HessianSP.o: CB05TUCl_EPA_HessianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_Hessian.o:  CB05TUCl_EPA_Hessian.f90 $(GENOBJ) $(HESSPOBJ)
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_StoichiomSP.o: CB05TUCl_EPA_StoichiomSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_Stoichiom.o: CB05TUCl_EPA_Stoichiom.f90 $(GENOBJ) $(STMSPOBJ)
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_Util.o: CB05TUCl_EPA_Util.f90 $(GENOBJ) CB05TUCl_EPA_Monitor.o
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_Main.o: CB05TUCl_EPA_Main.f90  $(ALLOBJ) \
                 CB05TUCl_EPA_Initialize.o CB05TUCl_EPA_Model.o CB05TUCl_EPA_Integrator.o
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_Model.o: CB05TUCl_EPA_Model.f90 $(ALLOBJ) CB05TUCl_EPA_Integrator.o
	$(FC) $(FOPT) -c $<

CB05TUCl_EPA_Integrator.o: CB05TUCl_EPA_Integrator.f90 $(ALLOBJ)
	$(FC) $(FOPT) -c $<

# Define rule for a user-defined module that gets USE-d by F90_Rates.
# This rule is only applied if both variables are not blank.
ifdef EXTERNAL_RATES_F90
ifdef EXTERNAL_RATES_OBJ
$(EXTERNAL_RATES_OBJ): $(EXTERNAL_RATES_F90) CB05TUCl_EPA_Precision.o CB05TUCl_EPA_Global.o CB05TUCl_EPA_Parameters.o
	$(FC) $(FOPT) -c $<
endif
endif

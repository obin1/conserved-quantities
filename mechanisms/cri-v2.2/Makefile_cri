#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: Set here the F90 compiler and options
#       Pedefined compilers: INTEL, PGF, HPUX, LAHEY
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Pick a default compiler if not supplied
ifndef COMPILER
#COMPILER = LAHEY
#COMPILER = INTEL
#COMPILER = PGF
#COMPILER = HPUX
COMPILER = GFORTRAN
endif

FC_LAHEY   = lf95
# More aggressive for production runs:
#FOPT_LAHEY = -Cpp --pca -O
# More checking for debugging:
FOPT_LAHEY = -Cpp --chk a,e,s,u --pca --ap -O0 -g --trap --trace --chkglobal

FC_INTEL   = ifort
# More aggressive for production runs:
#FOPT_INTEL = -cpp -O -fp-model precise -pc80 -prec_div
# More checking for debugging:
FOPT_INTEL = -cpp -O0 -fp-model strict -implicitnone -ftrapuv \
              -debug all -check all -warn all -g

FC_PGF     = pgf90
# More aggressive for production runs:
FOPT_PGF   = -Mpreprocess -O -fast -pc 80 -Kieee
# More checking for debugging:
#FOPT_PGF   = -Mpreprocess -O0 -Mbounds -Mchkfpstk -Mchkptr -Mchkstk \
#             -Ktrap=fp -pc 80 -Kieee

FC_HPUX    = f90
FOPT_HPUX  = -O -u +Oall +check=on

FC_GFORTRAN     = gfortran
FOPT_GFORTRAN   = -cpp -O -g -frecursive

# define FULL_ALGEBRA for non-sparse integration
FC   = $(FC_$(COMPILER))
FOPT = $(FOPT_$(COMPILER)) # -DFULL_ALGEBRA

LIBS =
#LIBS = -llapack -lblas

#############################################################################
# Test if various files are found on disk or not
# so that we can include/exclude them from the Make process
#############################################################################

# JacobianSP
HAS_JAC_SP =0
ifeq ($(shell test -f cri_JacobianSP.f90 && echo y),y)
  HAS_JAC_SP =1
endif

# Jacobian
HAS_JAC = 0
ifeq ($(shell test -f cri_Jacobian.f90 && echo y),y)
  HAS_JAC = 1
endif

# HessianSP
HAS_HES_SP = 0
ifeq ($(shell test -f cri_HessianSP.f90 && echo y),y)
  HAS_HES_SP = 1
endif

# Hessian
HAS_HES=0
ifeq ($(shell test -f cri_Hessian.f90 && echo y),y)
  HAS_HES = 1
endif

# StoichiomSP
HAS_STM_SP = 0
ifeq ($(shell test -f  cri_StoichiomSP.f90 && echo y),y)
  HAS_STM_SP=1
endif

# Stoichiom
HAS_STM = 0
ifeq ($(shell test -f  cri_Stoichiom.f90 && echo y),y)
  HAS_STM=1
endif

# If an external rates module has been supplied,
# also define the correspoinding object file
ifdef EXTERNAL_RATES_F90
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_F90:.f90=.o)
  EXTERNAL_RATES_OBJ := $(EXTERNAL_RATES_OBJ:.F90=.o)
endif

#############################################################################
# Construct lists of objects and sources
#############################################################################

# Command to create Matlab mex gateway routines
# Note: use $(FC) as the mex Fortran compiler
MEX  = mex

# NOTE: Allow for an external module to be USE-d by F90_Rates
# by specifying the relevant environment variables.
GENSRC = cri_Precision.f90  cri_Parameters.f90  \
         cri_Global.f90     $(EXTERNAL_RATES_F90)
GENOBJ = cri_Precision.o    cri_Parameters.o    \
         cri_Global.o       $(EXTERNAL_RATES_OBJ)

FUNSRC = cri_Function.f90
FUNOBJ = cri_Function.o

JACSRC   =
JACOBJ   =
JACSPOBJ =
ifeq ($(HAS_JAC_SP),1)
  JACSRC   += cri_JacobianSP.f90
  JACOBJ   += cri_JacobianSP.o
  JACSPOBJ += cri_JacobianSP.o
endif
ifeq ($(HAS_JAC),1)
  JACSRC   += cri_Jacobian.f90
  JACOBJ   += cri_Jacobian.o
endif

HESSRC   =
HESOBJ   =
HESSPOBJ =
ifeq ($(HAS_HES_SP),1)
  HESSRC   += cri_HessianSP.f90
  HESOBJ   += cri_HessianSP.o
  HESSPOBJ += cri_HessianSP.o
endif
ifeq ($(HAS_HES),1)
  HESSRC   += cri_Hessian.f90
  HESOBJ   += cri_Hessian.o
endif

STMSRC   =
STMOBJ   =
STMSPOBJ =
ifeq ($(HAS_STM_SP),1)
  STMSRC   += cri_StoichiomSP.f90
  STMOBJ   += cri_StoichiomSP.o
  STMSPOBJ += cri_StoichiomSP.o
endif
ifeq ($(HAS_STM),1)
  STMSRC   += cri_Stoichiom.f90
  STMOBJ   += cri_Stoichiom.o
endif

UTLSRC = cri_Rates.f90 cri_Util.f90 cri_Monitor.f90
UTLOBJ = cri_Rates.o   cri_Util.o   cri_Monitor.o

LASRC  = cri_LinearAlgebra.f90
LAOBJ  = cri_LinearAlgebra.o

STOCHSRC = cri_Stochastic.f90
STOCHOBJ = cri_Stochastic.o

MAINSRC = cri_Main.f90        cri_Initialize.f90 \
          cri_Integrator.f90  cri_Model.f90
MAINOBJ = cri_Main.o          cri_Initialize.o   \
          cri_Integrator.o    cri_Model.o

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       objects needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ALLOBJ = $(GENOBJ) $(FUNOBJ) $(JACOBJ) $(HESOBJ) $(STMOBJ) \
	 $(UTLOBJ) $(LAOBJ)

#############################################################################
# Makefile targets and rules
#############################################################################

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# User: modify the line below to include only the
#       executables needed by your application
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
all:    exe

exe:	$(ALLOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(MAINOBJ) $(LIBS) -o cri.exe

stochastic:$(ALLOBJ) $(STOCHOBJ) $(MAINOBJ)
	$(FC) $(FOPT) $(ALLOBJ) $(STOCHOBJ) $(MAINOBJ) $(LIBS) \
	-o cri_stochastic.exe

mex:    $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O cri_mex_Fun.f90     $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O cri_mex_Jac_SP.f90  $(ALLOBJ)
	$(MEX) FC#$(FC) -fortran -O cri_mex_Hessian.f90 $(ALLOBJ)

clean:
	rm -f *.o *.mod \
	cri*.dat cri.exe cri*.mexglx \
	cri.log *.csv

distclean:
	rm -f *.o *.mod \
	cri*.dat cri.exe cri.log \
	cri_*.f90 cri_*.f90 cri_*.mexglx \
	results*.m *.dat *.csv

cri_Precision.o: cri_Precision.f90
	$(FC) $(FOPT) -c $<

cri_Parameters.o: cri_Parameters.f90 cri_Precision.o
	$(FC) $(FOPT) -c $<

cri_Monitor.o: cri_Monitor.f90 cri_Precision.o
	$(FC) $(FOPT) -c $<

cri_Global.o: cri_Global.f90 cri_Parameters.o cri_Precision.o
	$(FC) $(FOPT) -c $<

cri_Initialize.o: cri_Initialize.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

cri_Function.o: cri_Function.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

cri_Stochastic.o: cri_Stochastic.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

cri_JacobianSP.o: cri_JacobianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

cri_Jacobian.o: cri_Jacobian.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

cri_LinearAlgebra.o: cri_LinearAlgebra.f90 $(GENOBJ) $(JACSPOBJ)
	$(FC) $(FOPT) -c $<

cri_Rates.o: cri_Rates.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

cri_HessianSP.o: cri_HessianSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

cri_Hessian.o:  cri_Hessian.f90 $(GENOBJ) $(HESSPOBJ)
	$(FC) $(FOPT) -c $<

cri_StoichiomSP.o: cri_StoichiomSP.f90 $(GENOBJ)
	$(FC) $(FOPT) -c $<

cri_Stoichiom.o: cri_Stoichiom.f90 $(GENOBJ) $(STMSPOBJ)
	$(FC) $(FOPT) -c $<

cri_Util.o: cri_Util.f90 $(GENOBJ) cri_Monitor.o
	$(FC) $(FOPT) -c $<

cri_Main.o: cri_Main.f90  $(ALLOBJ) \
                 cri_Initialize.o cri_Model.o cri_Integrator.o
	$(FC) $(FOPT) -c $<

cri_Model.o: cri_Model.f90 $(ALLOBJ) cri_Integrator.o
	$(FC) $(FOPT) -c $<

cri_Integrator.o: cri_Integrator.f90 $(ALLOBJ)
	$(FC) $(FOPT) -c $<

# Define rule for a user-defined module that gets USE-d by F90_Rates.
# This rule is only applied if both variables are not blank.
ifdef EXTERNAL_RATES_F90
ifdef EXTERNAL_RATES_OBJ
$(EXTERNAL_RATES_OBJ): $(EXTERNAL_RATES_F90) cri_Precision.o cri_Global.o cri_Parameters.o
	$(FC) $(FOPT) -c $<
endif
endif
